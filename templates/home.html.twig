{% extends "base.html.twig" %}

{% block title %}Home - Habal Habal Management System{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-gray-950 via-gray-900 to-gray-950 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md mx-auto bg-gradient-to-br from-gray-800 to-gray-900 rounded-lg shadow-2xl shadow-green-900/30 p-8 border border-green-900/30">
        <div class="flex justify-center mb-6">
            <img class="h-12 w-auto" src="{{ asset('images/HABAL.png') }}" alt="Habal-habal">
        </div>
        
        <h1 class="text-3xl font-bold text-white text-center mb-2">Habal Habal Management</h1>
        <div class="h-1 w-24 bg-gradient-to-r from-green-600 to-red-600 rounded-full mx-auto mb-6"></div>
        
        <p class="text-gray-300 text-center mb-8">
            Welcome to the Habal Habal fleet management system. All login functionality has been removed for this version.
        </p>
        
        <div class="space-y-4 text-gray-300 text-center">
            <p class="text-sm">Database: Clean and Ready</p>
            <p class="text-sm">Authentication: Disabled</p>
            <p class="text-sm">Status: Ready for new features</p>
            <div class="mt-6">
                <a href="{{ path('app_login') }}" class="inline-block rounded-lg bg-gradient-to-r from-green-600 to-green-700 py-3 px-6 text-sm font-semibold text-white hover:from-green-700 hover:to-green-800 transition-all shadow-lg shadow-green-600/50 hover:shadow-green-600/70">
                    Sign in
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
