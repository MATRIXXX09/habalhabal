{% extends "base.html.twig" %}

{% block title %}Staff Dashboard - Shipment Management System{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-gray-950 via-green-950 to-gray-950">
    <!-- Staff Sidebar -->
    {{ include('staff/_sidebar.html.twig') }}

    <!-- Main Content -->
    <main class="pl-72">
        <div class="px-8 py-6">
            <!-- Header Section -->
            <div class="mb-12">
                <div class="flex justify-between items-start">
                    <div>
                        <h1 class="text-5xl font-bold text-white">Staff Dashboard</h1>
                        <p class="text-green-400 mt-2 text-lg">Welcome, {{ app.user.email }}!</p>
                    </div>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="grid grid-cols-1 md:grid-cols-5 gap-6 mb-12">
                <a href="{{ path('staff_booking_index') }}" class="group bg-gradient-to-br from-green-500/10 to-emerald-600/10 rounded-xl shadow-lg hover:shadow-2xl transition transform hover:scale-105 p-6 border border-green-400/30 backdrop-blur-md hover:bg-gradient-to-br hover:from-green-500/20 hover:to-emerald-600/20">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-green-300 text-xs font-semibold uppercase tracking-wider">Bookings</p>
                            <p class="text-4xl font-bold text-white mt-3">{{ totalBookings }}</p>
                        </div>
                        <svg class="w-16 h-16 text-green-400 opacity-60 group-hover:opacity-100 transition" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                    </div>
                </a>

                <a href="{{ path('staff_shipment_index') }}" class="group bg-gradient-to-br from-green-600/10 to-green-700/10 rounded-xl shadow-lg hover:shadow-2xl transition transform hover:scale-105 p-6 border border-green-500/30 backdrop-blur-md hover:bg-gradient-to-br hover:from-green-600/20 hover:to-green-700/20">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-green-400 text-xs font-semibold uppercase tracking-wider">Shipments</p>
                            <p class="text-4xl font-bold text-white mt-3">{{ totalShipments }}</p>
                        </div>
                        <svg class="w-16 h-16 text-green-500 opacity-60 group-hover:opacity-100 transition" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2zm2 4h10v2H7V7zm0 4h10v2H7v-2zm0 4h6v2H7v-2z"></path>
                        </svg>
                    </div>
                </a>

                <a href="{{ path('staff_complaint_index') }}" class="group bg-gradient-to-br from-red-500/10 to-red-600/10 rounded-xl shadow-lg hover:shadow-2xl transition transform hover:scale-105 p-6 border border-red-400/30 backdrop-blur-md hover:bg-gradient-to-br hover:from-red-500/20 hover:to-red-600/20">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-red-300 text-xs font-semibold uppercase tracking-wider">Complaints</p>
                            <p class="text-4xl font-bold text-white mt-3">{{ totalComplaints }}</p>
                        </div>
                        <svg class="w-16 h-16 text-red-400 opacity-60 group-hover:opacity-100 transition" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"></path>
                        </svg>
                    </div>
                </a>

                <a href="{{ path('staff_vehicle_index') }}" class="group bg-gradient-to-br from-emerald-500/10 to-teal-600/10 rounded-xl shadow-lg hover:shadow-2xl transition transform hover:scale-105 p-6 border border-emerald-400/30 backdrop-blur-md hover:bg-gradient-to-br hover:from-emerald-500/20 hover:to-teal-600/20">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-emerald-300 text-xs font-semibold uppercase tracking-wider">Vehicles</p>
                            <p class="text-4xl font-bold text-white mt-3">{{ totalVehicles }}</p>
                        </div>
                        <svg class="w-16 h-16 text-emerald-400 opacity-60 group-hover:opacity-100 transition" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.22.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm11 0c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM5 11l1.5-4.5h11L19 11H5z"></path>
                        </svg>
                    </div>
                </a>

                <a href="{{ path('staff_rider_index') }}" class="group bg-gradient-to-br from-green-400/10 to-green-500/10 rounded-xl shadow-lg hover:shadow-2xl transition transform hover:scale-105 p-6 border border-green-300/30 backdrop-blur-md hover:bg-gradient-to-br hover:from-green-400/20 hover:to-green-500/20">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-green-300 text-xs font-semibold uppercase tracking-wider">Riders</p>
                            <p class="text-4xl font-bold text-white mt-3">{{ totalRiders }}</p>
                        </div>
                        <svg class="w-16 h-16 text-green-400 opacity-60 group-hover:opacity-100 transition" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"></path>
                        </svg>
                    </div>
                </a>
            </div>

            <!-- Quick Actions -->
            <div class="mb-12">
                <h2 class="text-3xl font-bold text-white mb-6">Quick Actions</h2>
                <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
                    <a href="{{ path('staff_booking_new') }}" class="bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white font-semibold py-4 px-6 rounded-lg transition shadow-lg hover:shadow-xl transform hover:scale-105 flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        New Booking
                    </a>

                    <a href="{{ path('staff_shipment_new') }}" class="bg-gradient-to-r from-green-700 to-green-800 hover:from-green-800 hover:to-green-900 text-white font-semibold py-4 px-6 rounded-lg transition shadow-lg hover:shadow-xl transform hover:scale-105 flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        New Shipment
                    </a>

                    <a href="{{ path('staff_complaint_new') }}" class="bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 text-white font-semibold py-4 px-6 rounded-lg transition shadow-lg hover:shadow-xl transform hover:scale-105 flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        New Complaint
                    </a>

                    <a href="{{ path('staff_vehicle_new') }}" class="bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-semibold py-4 px-6 rounded-lg transition shadow-lg hover:shadow-xl transform hover:scale-105 flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        New Vehicle
                    </a>

                    <a href="{{ path('staff_rider_new') }}" class="bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-semibold py-4 px-6 rounded-lg transition shadow-lg hover:shadow-xl transform hover:scale-105 flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        New Rider
                    </a>
                </div>
            </div>

            <!-- Recent Records Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Recent Shipments -->
                <div class="bg-gray-800/40 backdrop-blur-md rounded-xl shadow-2xl border border-white/10 overflow-hidden">
                    <div class="bg-gradient-to-r from-green-900/50 to-emerald-900/50 px-6 py-4 border-b border-white/10">
                        <h3 class="text-lg font-bold text-green-300 flex items-center gap-2">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z"></path>
                            </svg>
                            Recent Shipments
                        </h3>
                    </div>
                    <div class="divide-y divide-white/5">
                        {% if myShipments is empty %}
                            <div class="px-6 py-8 text-center text-gray-400">
                                <p>No shipments yet</p>
                            </div>
                        {% else %}
                            {% for shipment in myShipments %}
                                <div class="px-6 py-4 hover:bg-white/5 transition">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <p class="font-semibold text-white">{{ shipment.trackingNumber }}</p>
                                            <p class="text-xs text-gray-400 mt-1">{{ shipment.origin }} → {{ shipment.destination }}</p>
                                            <p class="text-xs text-gray-500 mt-1">{{ shipment.createdAt|date('M d, Y H:i') }}</p>
                                        </div>
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold {% if shipment.status == 'delivered' %}bg-emerald-500/20 text-emerald-300{% elseif shipment.status == 'in_transit' %}bg-blue-500/20 text-blue-300{% else %}bg-yellow-500/20 text-yellow-300{% endif %}">
                                            {{ shipment.status|default('Pending')|title }}
                                        </span>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>

                <!-- Recent Complaints -->
                <div class="bg-gray-800/40 backdrop-blur-md rounded-xl shadow-2xl border border-white/10 overflow-hidden">
                    <div class="bg-gradient-to-r from-red-900/50 to-red-900/50 px-6 py-4 border-b border-white/10">
                        <h3 class="text-lg font-bold text-red-300 flex items-center gap-2">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"></path>
                            </svg>
                            Recent Complaints
                        </h3>
                    </div>
                    <div class="divide-y divide-white/5">
                        {% if myComplaints is empty %}
                            <div class="px-6 py-8 text-center text-gray-400">
                                <p>No complaints yet</p>
                            </div>
                        {% else %}
                            {% for complaint in myComplaints %}
                                <div class="px-6 py-4 hover:bg-white/5 transition">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <p class="font-semibold text-white">{{ complaint.customerName }}</p>
                                            <p class="text-xs text-gray-400 mt-1">{{ complaint.message|slice(0, 40) }}...</p>
                                            <p class="text-xs text-gray-500 mt-1">{{ complaint.createdAt|date('M d, Y H:i') }}</p>
                                        </div>
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold {% if complaint.status == 'resolved' %}bg-emerald-500/20 text-emerald-300{% elseif complaint.status == 'pending' %}bg-yellow-500/20 text-yellow-300{% else %}bg-red-500/20 text-red-300{% endif %}">
                                            {{ complaint.status|default('Open')|title }}
                                        </span>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>

                <!-- Recent Vehicles -->
                <div class="bg-gray-800/40 backdrop-blur-md rounded-xl shadow-2xl border border-white/10 overflow-hidden">
                    <div class="bg-gradient-to-r from-emerald-900/50 to-teal-900/50 px-6 py-4 border-b border-white/10">
                        <h3 class="text-lg font-bold text-emerald-300 flex items-center gap-2">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.22.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99z"></path>
                            </svg>
                            Recent Vehicles
                        </h3>
                    </div>
                    <div class="divide-y divide-white/5">
                        {% if myVehicles is empty %}
                            <div class="px-6 py-8 text-center text-gray-400">
                                <p>No vehicles yet</p>
                            </div>
                        {% else %}
                            {% for vehicle in myVehicles %}
                                <div class="px-6 py-4 hover:bg-white/5 transition">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <p class="font-semibold text-white">{{ vehicle.plateNumber }}</p>
                                            <p class="text-xs text-gray-400 mt-1">{{ vehicle.type }} - {{ vehicle.model }}</p>
                                            <p class="text-xs text-gray-500 mt-1">{{ vehicle.createdAt|date('M d, Y H:i') }}</p>
                                        </div>
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold {% if vehicle.isAvailable %}bg-emerald-500/20 text-emerald-300{% else %}bg-orange-500/20 text-orange-300{% endif %}">
                                            {% if vehicle.isAvailable %}Available{% else %}In Use{% endif %}
                                        </span>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>

                <!-- Recent Riders -->
                <div class="bg-gray-800/40 backdrop-blur-md rounded-xl shadow-2xl border border-white/10 overflow-hidden">
                    <div class="bg-gradient-to-r from-cyan-900/50 to-blue-900/50 px-6 py-4 border-b border-white/10">
                        <h3 class="text-lg font-bold text-cyan-300 flex items-center gap-2">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"></path>
                            </svg>
                            Recent Riders
                        </h3>
                    </div>
                    <div class="divide-y divide-white/5">
                        {% if myRiders is empty %}
                            <div class="px-6 py-8 text-center text-gray-400">
                                <p>No riders yet</p>
                            </div>
                        {% else %}
                            {% for rider in myRiders %}
                                <div class="px-6 py-4 hover:bg-white/5 transition">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <p class="font-semibold text-white">{{ rider.fullName }}</p>
                                            <p class="text-xs text-gray-400 mt-1">{{ rider.vehicleType }} - {{ rider.plateNumber }}</p>
                                            <p class="text-xs text-gray-500 mt-1">{{ rider.createdAt|date('M d, Y H:i') }}</p>
                                        </div>
                                        {% if rider.status == 'available' %}
                                            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-gradient-to-r from-green-500/20 to-emerald-500/20 text-green-300 ring-1 ring-inset ring-green-400/40">
                                                <span class="h-2 w-2 rounded-full bg-green-400 animate-pulse"></span>
                                                Available
                                            </span>
                                        {% elseif rider.status == 'on_delivery' %}
                                            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-gradient-to-r from-yellow-500/20 to-amber-500/20 text-yellow-300 ring-1 ring-inset ring-yellow-400/40">
                                                <span class="h-2 w-2 rounded-full bg-yellow-400 animate-spin" style="animation: spin 3s linear infinite;"></span>
                                                On Delivery
                                            </span>
                                        {% elseif rider.status == 'on_leave' %}
                                            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-gradient-to-r from-blue-500/20 to-cyan-500/20 text-blue-300 ring-1 ring-inset ring-blue-400/40">
                                                <span class="h-2 w-2 rounded-full bg-blue-400"></span>
                                                On Leave
                                            </span>
                                        {% else %}
                                            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-gradient-to-r from-gray-500/20 to-slate-500/20 text-gray-300 ring-1 ring-inset ring-gray-400/40">
                                                <span class="h-2 w-2 rounded-full bg-gray-400"></span>
                                                Day Off
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

<style>
    @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .animate-pulse {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: .5; }
    }
</style>
{% endblock %}
