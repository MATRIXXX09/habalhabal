{% extends "base.html.twig" %}

{% block title %}Messages & Complaints - Staff Dashboard{% endblock %}

{% block body %}
<div class="bg-gray-900 min-h-screen p-8">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="mb-8">
            <a href="{{ path('app_staff_dashboard') }}" class="inline-flex items-center gap-2 text-green-400 hover:text-green-300 transition-colors mb-4">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                <span>Back to Dashboard</span>
            </a>
            <h1 class="text-3xl font-bold text-white">Messages & Complaints</h1>
            <p class="text-gray-400 mt-2">Contact form submissions and customer complaints</p>
        </div>

        <!-- Messages & Complaints List -->
        {% set allItems = [] %}
        {% for message in messages %}
            {% set allItems = allItems|merge([{type: 'message', item: message}]) %}
        {% endfor %}
        {% for complaint in complaints|default([]) %}
            {% set allItems = allItems|merge([{type: 'complaint', item: complaint}]) %}
        {% endfor %}

        {% if allItems|length > 0 %}
            <div class="space-y-4">
                {% for data in allItems %}
                    {% set isMessage = data.type == 'message' %}
                    {% set isComplaint = data.type == 'complaint' %}
                    
                    <div class="bg-gray-800 rounded-lg p-6 border {% if isComplaint %}border-red-500 bg-red-950/20{% elseif not data.item.isRead() %}border-green-500 bg-green-950/20{% else %}border-gray-700{% endif %} hover:{% if isComplaint %}border-red-600{% else %}border-green-600{% endif %} transition-colors">
                        <!-- Header Row -->
                        <div class="flex items-start justify-between mb-3">
                            <div class="flex-1">
                                {% if isComplaint %}
                                    <h3 class="text-lg font-semibold text-white">Customer Complaint</h3>
                                    <p class="text-sm text-gray-400">From: <strong class="text-red-400">{{ data.item.customerName }}</strong></p>
                                {% else %}
                                    <h3 class="text-lg font-semibold text-white">{{ data.item.subject }}</h3>
                                    <p class="text-sm text-gray-400">From: <strong class="text-green-400">{{ data.item.senderEmail }}</strong></p>
                                {% endif %}
                            </div>
                            <div class="text-right flex gap-2 items-center">
                                {% if isComplaint %}
                                    <span class="inline-block bg-gradient-to-r from-red-600 to-orange-600 text-white text-xs px-3 py-1 rounded-full font-semibold">Complaint</span>
                                    {% if data.item.status != 'resolved' %}
                                        <span class="inline-block bg-yellow-600 text-white text-xs px-3 py-1 rounded-full">{{ data.item.status|upper }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="inline-block bg-gradient-to-r from-green-600 to-emerald-600 text-white text-xs px-3 py-1 rounded-full font-semibold">Contact Form</span>
                                    {% if not data.item.isRead() %}
                                        <span class="inline-block bg-cyan-600 text-white text-xs px-3 py-1 rounded-full">New</span>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </div>

                        <!-- Message Content -->
                        <div class="bg-gray-900 rounded p-4 mb-4 border border-gray-700">
                            <p class="text-gray-300 text-sm whitespace-pre-wrap">{{ data.item.message }}</p>
                        </div>

                        <!-- Footer -->
                        <div class="flex items-center justify-between text-xs text-gray-500">
                            <span>📅 {{ data.item.createdAt|date('M d, Y \a\t H:i') }}</span>
                            <div class="flex gap-2 items-center flex-wrap justify-end">
                                {% if isMessage and not data.item.isRead() %}
                                    <button 
                                        onclick="markAsRead({{ data.item.id }})"
                                        class="text-green-400 hover:text-green-300 hover:bg-green-600/20 transition-colors font-medium px-3 py-1 rounded"
                                    >
                                        Mark as read
                                    </button>
                                {% elseif isMessage %}
                                    <span class="text-green-600">✓ Read on {{ data.item.readAt|date('M d, Y') }}</span>
                                {% elseif isComplaint %}
                                    <span class="text-gray-400">Status: <strong class="text-gray-300">{{ data.item.status|capitalize }}</strong></span>
                                {% endif %}
                                
                                {% if isMessage and data.item.status != 'resolved' %}
                                    <button 
                                        onclick="openReplyModal({{ data.item.id }})"
                                        class="bg-blue-600 text-white hover:bg-blue-700 transition-colors font-medium px-4 py-2 rounded text-sm"
                                    >
                                        Reply
                                    </button>
                                {% elseif isMessage and data.item.status == 'resolved' %}
                                    <span class="bg-green-600 text-white px-3 py-1 rounded text-sm">✓ Replied</span>
                                {% endif %}

                                {% if isComplaint and data.item.status != 'resolved' %}
                                    <button 
                                        onclick="resolveComplaint({{ data.item.id }})"
                                        class="bg-green-600 text-white hover:bg-green-700 transition-colors font-medium px-4 py-2 rounded text-sm"
                                    >
                                        Mark Resolved
                                    </button>
                                {% elseif isComplaint and data.item.status == 'resolved' %}
                                    <span class="bg-green-600 text-white px-3 py-1 rounded text-sm">✓ Resolved</span>
                                {% endif %}

                                <button 
                                    onclick="deleteItem('{{ isMessage ? 'message' : 'complaint' }}', {{ data.item.id }})"
                                    class="bg-red-600 text-white hover:bg-red-700 transition-colors font-medium px-4 py-2 rounded text-sm"
                                >
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="bg-gray-800 rounded-lg p-12 text-center border border-gray-700">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                <h3 class="mt-4 text-lg font-medium text-white">No messages or complaints yet</h3>
                <p class="mt-2 text-gray-400">Contact form submissions and customer complaints will appear here</p>
            </div>
        {% endif %}
    </div>
</div>

<script>
    function markAsRead(messageId) {
        fetch(`/staff/messages/${messageId}/mark-read`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/json'
            }
        }).then(response => response.json()).then(data => {
            if (data.success) {
                location.reload();
            }
        }).catch(error => {
            console.error('Error:', error);
        });
    }

    function deleteItem(type, itemId) {
        if (!confirm('Are you sure you want to delete this ' + type + '? This action cannot be undone.')) {
            return;
        }

        const endpoint = type === 'message' ? `/staff/messages/${itemId}/delete` : `/staff/complaints/${itemId}/delete`;
        
        fetch(endpoint, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/json'
            }
        }).then(response => response.json()).then(data => {
            if (data.success) {
                location.reload();
            }
        }).catch(error => {
            console.error('Error:', error);
            alert('Failed to delete ' + type + '. Please try again.');
        });
    }

    function openReplyModal(messageId) {
        const modal = document.getElementById('replyModal');
        const replyTextarea = document.getElementById('replyText');
        const submitBtn = document.getElementById('submitReplyBtn');
        
        replyTextarea.value = '';
        submitBtn.onclick = () => submitReply(messageId);
        modal.style.display = 'flex';
    }

    function closeReplyModal() {
        document.getElementById('replyModal').style.display = 'none';
    }

    function submitReply(messageId) {
        const replyText = document.getElementById('replyText').value.trim();
        
        if (!replyText) {
            alert('Please enter a reply');
            return;
        }

        fetch(`/staff/messages/${messageId}/reply`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ reply: replyText })
        }).then(response => response.json()).then(data => {
            if (data.success) {
                closeReplyModal();
                location.reload();
            } else {
                alert('Failed to submit reply');
            }
        }).catch(error => {
            console.error('Error:', error);
            alert('Error submitting reply');
        });
    }

    function resolveComplaint(complaintId) {
        if (!confirm('Mark this complaint as resolved?')) {
            return;
        }

        fetch(`/staff/complaints/${complaintId}/resolve`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/json'
            }
        }).then(response => response.json()).then(data => {
            if (data.success) {
                location.reload();
            }
        }).catch(error => {
            console.error('Error:', error);
            alert('Failed to resolve complaint');
        });
    }

    window.onclick = function(event) {
        const modal = document.getElementById('replyModal');
        if (event.target == modal) {
            closeReplyModal();
        }
    }
</script>

<!-- Reply Modal -->
<div id="replyModal" style="display:none;" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-gray-800 rounded-lg p-6 max-w-2xl w-full mx-4 border border-gray-700">
        <h2 class="text-xl font-bold text-white mb-4">Reply to Message</h2>
        <textarea 
            id="replyText"
            class="w-full bg-gray-900 text-white border border-gray-600 rounded p-3 mb-4 min-h-32 focus:border-green-500 focus:outline-none"
            placeholder="Enter your reply..."
        ></textarea>
        <div class="flex gap-2 justify-end">
            <button 
                onclick="closeReplyModal()"
                class="bg-gray-700 text-white hover:bg-gray-600 px-4 py-2 rounded transition-colors"
            >
                Cancel
            </button>
            <button 
                id="submitReplyBtn"
                class="bg-blue-600 text-white hover:bg-blue-700 px-4 py-2 rounded transition-colors"
            >
                Send Reply
            </button>
        </div>
    </div>
</div>
{% endblock %}
