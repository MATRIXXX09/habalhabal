{% extends 'base.html.twig' %}

{% block title %}Staff Profile{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900">
    <!-- Staff Sidebar -->
    {{ include('staff/_sidebar.html.twig') }}

    <!-- Main Content -->
    <main class="pl-72">
        <div class="px-8 py-6">
            <!-- Header Section -->
            <div class="mb-8">
                <div class="flex justify-between items-start">
                    <div>
                        <h1 class="text-3xl font-bold text-white">Staff Profile</h1>
                        <p class="text-indigo-300 mt-2 text-lg">View and manage your account information</p>
                    </div>
                    <a href="{{ path('app_staff_dashboard') }}" class="flex items-center gap-2 px-4 py-2 bg-indigo-600/50 hover:bg-indigo-600 text-white rounded-lg transition-colors duration-200">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                        Back to Dashboard
                    </a>
                </div>
            </div>

            <!-- Profile Card -->
            <div class="max-w-2xl">
                <div class="bg-gradient-to-br from-white/10 to-white/5 backdrop-blur-md border border-white/20 rounded-2xl shadow-2xl overflow-hidden">
                    <!-- Header -->
                    <div class="bg-gradient-to-r from-blue-500/20 to-indigo-500/20 px-6 py-6 border-b border-white/10">
                        <div class="flex items-center gap-4">
                            <div class="h-20 w-20 rounded-full bg-gradient-to-br from-blue-400 to-indigo-600 flex items-center justify-center text-white text-3xl font-bold shadow-lg">
                                {{ user.email|slice(0, 1)|upper }}
                            </div>
                            <div>
                                <h2 class="text-2xl font-semibold text-white">{{ user.email }}</h2>
                                <div class="flex items-center gap-2 mt-2">
                                    {% for role in user.roles %}
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-400/20 text-blue-200">
                                            {{ role|replace({'ROLE_': ''}) }}
                                        </span>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Account Info -->
                    <div class="p-6 space-y-6">
                        <!-- Email -->
                        <div>
                            <label class="text-sm font-semibold text-gray-300">Email Address</label>
                            <div class="mt-2 p-4 bg-white/5 rounded-lg border border-white/10 backdrop-blur-sm">
                                <p class="text-white">{{ user.email }}</p>
                            </div>
                        </div>

                        <!-- Roles -->
                        <div>
                            <label class="text-sm font-semibold text-gray-300">Account Roles</label>
                            <div class="mt-2 p-4 bg-white/5 rounded-lg border border-white/10 backdrop-blur-sm">
                                {% if user.roles %}
                                    <div class="flex flex-wrap gap-2">
                                        {% for role in user.roles %}
                                            <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-400/20 text-blue-200 ring-1 ring-inset ring-blue-400/30">
                                                {{ role|replace({'ROLE_': ''}) }}
                                            </span>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <p class="text-gray-400">No roles assigned</p>
                                {% endif %}
                            </div>
                        </div>

                        <!-- Verification Status -->
                        <div>
                            <label class="text-sm font-semibold text-gray-300">Verification Status</label>
                            <div class="mt-2 p-4 bg-white/5 rounded-lg border border-white/10 backdrop-blur-sm">
                                {% if user.isVerified %}
                                    <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-green-400/20 text-green-200 ring-1 ring-inset ring-green-400/30">
                                        ✓ Verified
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-yellow-400/20 text-yellow-200 ring-1 ring-inset ring-yellow-400/30">
                                        ⏳ Not Verified
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        <!-- Account Status -->
                        <div>
                            <label class="text-sm font-semibold text-gray-300">Account Status</label>
                            <div class="mt-2 p-4 bg-white/5 rounded-lg border border-white/10 backdrop-blur-sm">
                                {% if user.status == 'active' %}
                                    <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-green-400/20 text-green-200 ring-1 ring-inset ring-green-400/30">
                                        ✓ Active
                                    </span>
                                {% elseif user.status == 'disabled' %}
                                    <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-red-400/20 text-red-200 ring-1 ring-inset ring-red-400/30">
                                        ✕ Disabled
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-gray-400/20 text-gray-200 ring-1 ring-inset ring-gray-400/30">
                                        {{ user.status|capitalize }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="border-t border-white/10 pt-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <a href="{{ path('app_profile_change_password') }}" class="flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-blue-500 to-indigo-600 text-white rounded-lg hover:opacity-90 transition-all duration-200 shadow-lg hover:shadow-xl">
                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                    </svg>
                                    Change Password
                                </a>
                                <a href="{{ path('app_logout') }}" class="flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-red-500 to-pink-600 text-white rounded-lg hover:opacity-90 transition-all duration-200 shadow-lg hover:shadow-xl">
                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                    </svg>
                                    Logout
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
