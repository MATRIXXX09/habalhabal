{% extends 'base.html.twig' %}

{% block title %}My Riders - Staff{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
            <div>
                <a href="{{ path('app_staff_dashboard') }}" class="text-indigo-300 hover:text-indigo-200 mb-4 inline-flex items-center gap-2 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                    Back to Dashboard
                </a>
                <h1 class="text-4xl font-bold text-white mt-2">My Riders</h1>
                <p class="text-indigo-300 mt-1">Manage and track your delivery riders</p>
            </div>
            <a href="{{ path('staff_rider_new') }}" class="bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-700 hover:to-blue-700 text-white font-bold py-3 px-6 rounded-lg shadow-lg hover:shadow-xl transition-all transform hover:scale-105">
                <span class="flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    Create Rider
                </span>
            </a>
        </div>

        <!-- Success Messages -->
        {% if app.flashes('success') %}
            {% for message in app.flashes('success') %}
                <div class="bg-gradient-to-r from-green-600 to-emerald-600 border border-green-400/30 text-white px-6 py-4 rounded-lg mb-6 shadow-lg flex items-center gap-3">
                    <svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
        {% endif %}

        <!-- Riders Table -->
        {% if riders %}
            <div class="bg-gray-800/40 backdrop-blur-md rounded-xl shadow-2xl border border-white/10 overflow-hidden">
                <div class="overflow-x-auto">
                    <table id="staffRidersTable" class="w-full">
                        <thead class="bg-gradient-to-r from-cyan-900/50 to-blue-900/50 border-b border-white/10">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-cyan-300 uppercase tracking-wider">Rider Name</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-cyan-300 uppercase tracking-wider">Contact</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-cyan-300 uppercase tracking-wider">Vehicle</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-cyan-300 uppercase tracking-wider">Status</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-cyan-300 uppercase tracking-wider">Created</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-cyan-300 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            {% for rider in riders %}
                                <tr class="table-row hover:bg-white/5 transition-colors">
                                    <td class="px-6 py-4 text-sm font-semibold text-white">
                                        <div class="flex items-center gap-2">
                                            <span>{{ rider.firstName }} {{ rider.lastName }}</span>
                                            {% if not rider.createdBy %}
                                                <span class="text-xs bg-purple-600/50 px-2 py-0.5 rounded text-purple-200 font-semibold border border-purple-500/50">Admin</span>
                                            {% endif %}
                                        </div>
                                        <div class="text-xs text-gray-400">ID: #{{ rider.id }}</div>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-300">{{ rider.contactNumber }}</td>
                                    <td class="px-6 py-4 text-sm text-gray-300">
                                        <div class="flex items-center gap-2">
                                            <span class="text-gray-400">{{ rider.vehicleType }}</span>
                                            {% if rider.plateNumber %}
                                                <span class="text-xs bg-gray-700/50 px-2 py-1 rounded text-gray-300 font-mono">{{ rider.plateNumber }}</span>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-sm">
                                        <div class="status-dropdown-staff relative inline-block">
                                            <button type="button" class="status-trigger-staff inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-xs font-semibold transition-all cursor-pointer" data-rider-id="{{ rider.id }}" data-current-status="{{ rider.status }}">
                                                {% if rider.status == 'available' %}
                                                    <span class="status-dot h-2 w-2 rounded-full bg-green-400 animate-pulse"></span>
                                                    <span class="status-text text-green-300 bg-gradient-to-r from-green-500/20 to-emerald-500/20 ring-1 ring-inset ring-green-400/40 px-2 py-1 rounded">Available</span>
                                                {% elseif rider.status == 'on_delivery' %}
                                                    <span class="status-dot h-2 w-2 rounded-full bg-yellow-400" style="animation: spin 3s linear infinite;"></span>
                                                    <span class="status-text text-yellow-300 bg-gradient-to-r from-yellow-500/20 to-amber-500/20 ring-1 ring-inset ring-yellow-400/40 px-2 py-1 rounded">On Delivery</span>
                                                {% elseif rider.status == 'on_leave' %}
                                                    <span class="status-dot h-2 w-2 rounded-full bg-blue-400"></span>
                                                    <span class="status-text text-blue-300 bg-gradient-to-r from-blue-500/20 to-cyan-500/20 ring-1 ring-inset ring-blue-400/40 px-2 py-1 rounded">On Leave</span>
                                                {% else %}
                                                    <span class="status-dot h-2 w-2 rounded-full bg-gray-400"></span>
                                                    <span class="status-text text-gray-300 bg-gradient-to-r from-gray-500/20 to-slate-500/20 ring-1 ring-inset ring-gray-400/40 px-2 py-1 rounded">Day Off</span>
                                                {% endif %}
                                            </button>
                                            
                                            <!-- Status dropdown menu -->
                                            <div class="status-menu-staff hidden absolute left-0 top-full mt-1 w-48 bg-gray-800 border border-gray-700 rounded-lg shadow-xl z-50 py-1">
                                                <form method="POST" action="{{ path('staff_rider_toggle_status', {'id': rider.id}) }}" class="status-option-available">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_status_' ~ rider.id) }}">
                                                    <input type="hidden" name="status" value="available">
                                                    <button type="submit" class="w-full text-left px-4 py-2 text-sm text-green-300 hover:bg-green-500/10 flex items-center gap-2">
                                                        <span class="h-2 w-2 rounded-full bg-green-400"></span>
                                                        Available
                                                    </button>
                                                </form>
                                                <form method="POST" action="{{ path('staff_rider_toggle_status', {'id': rider.id}) }}" class="status-option-delivery">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_status_' ~ rider.id) }}">
                                                    <input type="hidden" name="status" value="on_delivery">
                                                    <button type="submit" class="w-full text-left px-4 py-2 text-sm text-yellow-300 hover:bg-yellow-500/10 flex items-center gap-2">
                                                        <span class="h-2 w-2 rounded-full bg-yellow-400 animate-spin" style="animation: spin 3s linear infinite;"></span>
                                                        On Delivery
                                                    </button>
                                                </form>
                                                <form method="POST" action="{{ path('staff_rider_toggle_status', {'id': rider.id}) }}" class="status-option-leave">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_status_' ~ rider.id) }}">
                                                    <input type="hidden" name="status" value="on_leave">
                                                    <button type="submit" class="w-full text-left px-4 py-2 text-sm text-blue-300 hover:bg-blue-500/10 flex items-center gap-2">
                                                        <span class="h-2 w-2 rounded-full bg-blue-400"></span>
                                                        On Leave
                                                    </button>
                                                </form>
                                                <form method="POST" action="{{ path('staff_rider_toggle_status', {'id': rider.id}) }}" class="status-option-dayoff">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_status_' ~ rider.id) }}">
                                                    <input type="hidden" name="status" value="day_off">
                                                    <button type="submit" class="w-full text-left px-4 py-2 text-sm text-gray-300 hover:bg-gray-700/50 flex items-center gap-2">
                                                        <span class="h-2 w-2 rounded-full bg-gray-400"></span>
                                                        Day Off
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-400">{{ rider.createdAt|date('M d, Y') }}</td>
                                    <td class="px-6 py-4 text-sm space-x-3 flex items-center">
                                        <a href="{{ path('staff_rider_show', {'id': rider.id}) }}" class="text-indigo-400 hover:text-indigo-300 font-medium transition-colors">View</a>
                                        <a href="{{ path('staff_rider_edit', {'id': rider.id}) }}" class="text-amber-400 hover:text-amber-300 font-medium transition-colors">Edit</a>
                                        <form class="inline-form" method="post" action="{{ path('staff_rider_delete', {'id': rider.id}) }}" onsubmit="return confirm('Are you sure?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rider.id) }}">
                                            <button type="submit" class="text-red-400 hover:text-red-300 font-medium transition-colors">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% else %}
            <div class="bg-gradient-to-br from-cyan-500/10 to-blue-500/10 border border-cyan-400/30 rounded-xl p-8 text-center">
                <svg class="w-16 h-16 mx-auto text-cyan-400 mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                <p class="text-cyan-300 text-lg font-medium">No riders yet</p>
                <p class="text-cyan-400/70 mt-1">Create your first rider to get started</p>
                <a href="{{ path('staff_rider_new') }}" class="mt-6 inline-flex items-center gap-2 bg-cyan-600 hover:bg-cyan-700 text-white font-semibold py-2 px-6 rounded-lg transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    Create Rider
                </a>
            </div>
        {% endif %}
    </div>
</div>

<script>
    // Handle status dropdown menu for staff riders
    document.querySelectorAll('.status-trigger-staff').forEach(trigger => {
        trigger.addEventListener('click', function(e) {
            e.stopPropagation();
            const dropdown = this.closest('.status-dropdown-staff');
            const menu = dropdown.querySelector('.status-menu-staff');
            
            // Close other menus
            document.querySelectorAll('.status-menu-staff').forEach(m => {
                if (m !== menu) m.classList.add('hidden');
            });
            
            menu.classList.toggle('hidden');
        });
    });

    // Close dropdown when clicking on status option
    document.querySelectorAll('.status-menu-staff form button').forEach(btn => {
        btn.addEventListener('click', function(e) {
            const form = this.closest('form');
            const dropdown = form.closest('.status-dropdown-staff');
            
            // Show loading state
            const trigger = dropdown.querySelector('.status-trigger-staff');
            trigger.style.opacity = '0.5';
            trigger.style.pointerEvents = 'none';
            
            // Get the new status
            const newStatus = form.querySelector('input[name="status"]').value;
            const statusLabels = {
                'available': 'Available',
                'on_delivery': 'On Delivery',
                'on_leave': 'On Leave',
                'day_off': 'Day Off'
            };
            
            showNotification(statusLabels[newStatus]);
        });
    });

    // Close dropdown when clicking outside
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.status-dropdown-staff')) {
            document.querySelectorAll('.status-menu-staff').forEach(menu => {
                menu.classList.add('hidden');
            });
        }
    });

    function showNotification(newStatus) {
        const notification = document.createElement('div');
        notification.className = 'fixed top-4 right-4 p-4 rounded-lg text-white font-medium shadow-lg animate-bounce z-50';
        
        const statusStyles = {
            'Available': 'bg-gradient-to-r from-green-500 to-emerald-500',
            'On Delivery': 'bg-gradient-to-r from-yellow-500 to-amber-500',
            'On Leave': 'bg-gradient-to-r from-blue-500 to-cyan-500',
            'Day Off': 'bg-gradient-to-r from-gray-500 to-slate-500'
        };
        
        const icons = {
            'Available': '✓',
            'On Delivery': '⚙',
            'On Leave': '📋',
            'Day Off': '😴'
        };
        
        notification.classList.add(statusStyles[newStatus] || 'bg-gray-600');
        notification.textContent = icons[newStatus] + ' Status updated to: ' + newStatus;
        
        document.body.appendChild(notification);
        setTimeout(() => {
            notification.style.animation = 'slideOut 0.3s ease-out forwards';
            setTimeout(() => notification.remove(), 300);
        }, 3000);
    }

    // Add CSS animations
    const style = document.createElement('style');
    style.textContent = `
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        @keyframes slideOut {
            to {
                transform: translateX(400px);
                opacity: 0;
            }
        }
        .animate-pulse {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: .5; }
        }
    `;
    document.head.appendChild(style);
</script>
{% endblock %}
