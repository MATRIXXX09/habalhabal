{% extends 'base.html.twig' %}

{% block title %}View Rider - Staff{% endblock %}

{% block body %}
<div class="container mx-auto py-8 px-4 max-w-2xl">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-800">Rider #{{ rider.id }}</h1>
        <a href="{{ path('staff_rider_index') }}" class="text-gray-600 hover:text-gray-800">← Back</a>
    </div>

    <div class="bg-white rounded-lg shadow p-6 mb-6">
        <div class="grid grid-cols-2 gap-6">
            <div>
                <p class="text-sm text-gray-600">First Name</p>
                <p class="text-lg font-semibold text-gray-900">{{ rider.firstName }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-600">Last Name</p>
                <p class="text-lg font-semibold text-gray-900">{{ rider.lastName }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-600">Contact Number</p>
                <p class="text-gray-900">{{ rider.contactNumber }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-600">License Number</p>
                <p class="text-gray-900">{{ rider.licenseNumber }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-600">Vehicle Type</p>
                <p class="text-gray-900">{{ rider.vehicleType }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-600">Plate Number</p>
                <p class="text-gray-900">{{ rider.plateNumber }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-600">Available</p>
                <p class="text-gray-900">{{ rider.isAvailable ? 'Yes' : 'No' }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-600">Created</p>
                <p class="text-gray-900">{{ rider.createdAt|date('M d, Y H:i') }}</p>
            </div>
            <div class="col-span-2">
                <p class="text-sm text-gray-600">Created By</p>
                <p class="text-gray-900">{{ rider.createdBy.email }}</p>
            </div>
        </div>
    </div>

    <div class="flex space-x-4">
        <a href="{{ path('staff_rider_edit', {'id': rider.id}) }}" class="bg-yellow-600 hover:bg-yellow-700 text-white font-bold py-2 px-6 rounded">
            Edit
        </a>
        <form class="inline-form" method="post" action="{{ path('staff_rider_delete', {'id': rider.id}) }}" onsubmit="return confirm('Are you sure?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rider.id) }}">
            <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-6 rounded">
                Delete
            </button>
        </form>
    </div>
</div>
{% endblock %}
