{% extends 'base.html.twig' %}

{% block title %}Create/Edit Rider - Staff{% endblock %}

{% block body %}
<div class="container mx-auto py-8 px-4 max-w-2xl">
    <h1 class="text-3xl font-bold text-gray-800 mb-8">
        {% if form.vars.value.id %}Edit{% else %}Create{% endif %} Rider
    </h1>

    {{ form_start(form) }}
        <div class="bg-white rounded-lg shadow p-6">
            <div class="mb-6">
                {{ form_label(form.firstName, 'First Name', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(form.firstName, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500'}}) }}
                {% if form.firstName.vars.errors %}
                    <div class="text-red-600 text-sm mt-2">{{ form_errors(form.firstName) }}</div>
                {% endif %}
            </div>

            <div class="mb-6">
                {{ form_label(form.lastName, 'Last Name', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(form.lastName, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500'}}) }}
                {% if form.lastName.vars.errors %}
                    <div class="text-red-600 text-sm mt-2">{{ form_errors(form.lastName) }}</div>
                {% endif %}
            </div>

            <div class="mb-6">
                {{ form_label(form.contactNumber, 'Contact Number', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(form.contactNumber, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500'}}) }}
                {% if form.contactNumber.vars.errors %}
                    <div class="text-red-600 text-sm mt-2">{{ form_errors(form.contactNumber) }}</div>
                {% endif %}
            </div>

            <div class="mb-6">
                {{ form_label(form.licenseNumber, 'License Number', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(form.licenseNumber, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500'}}) }}
                {% if form.licenseNumber.vars.errors %}
                    <div class="text-red-600 text-sm mt-2">{{ form_errors(form.licenseNumber) }}</div>
                {% endif %}
            </div>

            <div class="mb-6">
                {{ form_label(form.vehicleType, 'Vehicle Type', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(form.vehicleType, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500'}}) }}
                {% if form.vehicleType.vars.errors %}
                    <div class="text-red-600 text-sm mt-2">{{ form_errors(form.vehicleType) }}</div>
                {% endif %}
            </div>

            <div class="mb-6">
                {{ form_label(form.plateNumber, 'Plate Number', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(form.plateNumber, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500'}}) }}
                {% if form.plateNumber.vars.errors %}
                    <div class="text-red-600 text-sm mt-2">{{ form_errors(form.plateNumber) }}</div>
                {% endif %}
            </div>

            <div class="mb-6">
                {{ form_label(form.email, 'Email', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(form.email, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500'}}) }}
                {% if form.email.vars.errors %}
                    <div class="text-red-600 text-sm mt-2">{{ form_errors(form.email) }}</div>
                {% endif %}
            </div>

            <div class="mb-6">
                {{ form_label(form.password, 'Password', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(form.password, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500'}}) }}
                {% if form.password.vars.errors %}
                    <div class="text-red-600 text-sm mt-2">{{ form_errors(form.password) }}</div>
                {% endif %}
            </div>

            <div class="flex space-x-4">
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-6 rounded">
                    {% if form.vars.value.id %}Update{% else %}Create{% endif %}
                </button>
                <a href="{{ path('staff_rider_index') }}" class="bg-gray-400 hover:bg-gray-500 text-white font-bold py-2 px-6 rounded">
                    Cancel
                </a>
            </div>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
