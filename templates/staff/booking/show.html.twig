{% extends "base.html.twig" %}

{% block title %}Booking Details - Staff Dashboard{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900">
    {{ include('staff/_sidebar.html.twig') }}

    <main class="pl-72">
        <div class="px-8 py-6">
            <!-- Header Section -->
            <div class="mb-8">
                <div class="flex items-center gap-4 mb-6">
                    <a href="{{ path('staff_booking_index') }}" class="text-indigo-400 hover:text-indigo-300">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                        </svg>
                    </a>
                    <div class="flex-1">
                        <h1 class="text-4xl font-bold text-white">Booking #{{ booking.id }}</h1>
                        <p class="text-indigo-300 mt-1">{{ booking.createdAt|date('F d, Y - H:i') }}</p>
                    </div>
                    <span class="px-4 py-2 rounded-full font-semibold text-sm
                        {% if booking.status == 'pending' %}bg-yellow-500/20 text-yellow-200
                        {% elseif booking.status == 'confirmed' %}bg-blue-500/20 text-blue-200
                        {% elseif booking.status == 'assigned' %}bg-cyan-500/20 text-cyan-200
                        {% elseif booking.status == 'in_transit' %}bg-orange-500/20 text-orange-200
                        {% elseif booking.status == 'completed' %}bg-green-500/20 text-green-200
                        {% elseif booking.status == 'cancelled' %}bg-red-500/20 text-red-200
                        {% endif %}">
                        {{ booking.status|replace({'_': ' '})|capitalize }}
                    </span>
                </div>
            </div>

            <!-- Main Content Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Left Column - Booking Details -->
                <div class="lg:col-span-2 space-y-6">
                    <!-- Customer Information -->
                    <div class="bg-white/10 backdrop-blur-md rounded-lg border border-white/20 p-6 shadow-xl">
                        <h3 class="text-xl font-bold text-white mb-6">👤 Customer Information</h3>
                        <div class="grid grid-cols-2 gap-6">
                            <div>
                                <p class="text-indigo-300 text-sm">Customer Name</p>
                                <p class="text-white font-semibold text-lg">{{ booking.customerName }}</p>
                            </div>
                            <div>
                                <p class="text-indigo-300 text-sm">Contact Phone</p>
                                <p class="text-white font-semibold text-lg">{{ booking.customerPhone }}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Parcel Information -->
                    <div class="bg-white/10 backdrop-blur-md rounded-lg border border-white/20 p-6 shadow-xl">
                        <h3 class="text-xl font-bold text-white mb-6">📦 Parcel Information</h3>
                        <div class="grid grid-cols-2 gap-6">
                            <div>
                                <p class="text-indigo-300 text-sm">Type</p>
                                <p class="text-white font-semibold">{{ booking.parcelType|replace({'_': ' '})|capitalize }}</p>
                            </div>
                            <div>
                                <p class="text-indigo-300 text-sm">Weight</p>
                                <p class="text-white font-semibold">{{ booking.parcelWeight ?? 'Not specified' }} {% if booking.parcelWeight %}kg{% endif %}</p>
                            </div>
                            <div class="col-span-2">
                                <p class="text-indigo-300 text-sm">Description</p>
                                <p class="text-white">{{ booking.parcelDescription ?? 'No description' }}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Pickup Details -->
                    <div class="bg-white/10 backdrop-blur-md rounded-lg border border-white/20 p-6 shadow-xl">
                        <h3 class="text-xl font-bold text-white mb-6">📍 Pickup Location</h3>
                        <div class="space-y-4">
                            <div>
                                <p class="text-indigo-300 text-sm">Address</p>
                                <p class="text-white text-lg">{{ booking.pickupAddress }}</p>
                            </div>
                            <div>
                                <p class="text-indigo-300 text-sm">Requested Time</p>
                                <p class="text-white font-semibold">{{ booking.requestedPickupTime|date('M d, Y - H:i') }}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Delivery Details -->
                    <div class="bg-white/10 backdrop-blur-md rounded-lg border border-white/20 p-6 shadow-xl">
                        <h3 class="text-xl font-bold text-white mb-6">📍 Delivery Location</h3>
                        <div class="space-y-4">
                            <div>
                                <p class="text-indigo-300 text-sm">Address</p>
                                <p class="text-white text-lg">{{ booking.deliveryAddress }}</p>
                            </div>
                            {% if booking.requestedDeliveryTime %}
                                <div>
                                    <p class="text-indigo-300 text-sm">Requested Time</p>
                                    <p class="text-white font-semibold">{{ booking.requestedDeliveryTime|date('M d, Y - H:i') }}</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Special Instructions -->
                    {% if booking.specialInstructions %}
                        <div class="bg-white/10 backdrop-blur-md rounded-lg border border-white/20 p-6 shadow-xl">
                            <h3 class="text-xl font-bold text-white mb-4">⚠️ Special Instructions</h3>
                            <p class="text-indigo-200 whitespace-pre-wrap">{{ booking.specialInstructions }}</p>
                        </div>
                    {% endif %}
                </div>

                <!-- Right Column - Driver & Actions -->
                <div class="space-y-6">
                    <!-- Current Driver Assignment -->
                    {% if booking.assignedDriver %}
                        <div class="bg-gradient-to-br from-emerald-500/10 to-teal-500/10 rounded-lg border border-emerald-400/30 p-6 shadow-xl">
                            <h3 class="text-lg font-bold text-white mb-4">✅ Assigned Driver</h3>
                            <div class="space-y-4">
                                <div>
                                    <p class="text-emerald-300 text-sm">Driver Name</p>
                                    <p class="text-white font-semibold text-lg">{{ booking.assignedDriver.firstName }} {{ booking.assignedDriver.lastName }}</p>
                                </div>
                                <div>
                                    <p class="text-emerald-300 text-sm">Contact</p>
                                    <p class="text-white">{{ booking.assignedDriver.contactNumber }}</p>
                                </div>
                                <div>
                                    <p class="text-emerald-300 text-sm">Vehicle</p>
                                    <p class="text-white">{{ booking.assignedDriver.vehicleType }} - {{ booking.assignedDriver.plateNumber }}</p>
                                </div>
                                <div>
                                    <p class="text-emerald-300 text-sm">Assigned At</p>
                                    <p class="text-white">{{ booking.assignedAt|date('M d, Y - H:i') }}</p>
                                </div>
                            </div>
                        </div>
                    {% elseif booking.status == 'pending' %}
                        <!-- Available Drivers Section -->
                        <div class="bg-gradient-to-br from-blue-500/10 to-cyan-500/10 rounded-lg border border-blue-400/30 p-6 shadow-xl">
                            <h3 class="text-lg font-bold text-white mb-4">👥 Available Drivers ({{ availableDrivers|length }})</h3>
                            {% if availableDrivers|length > 0 %}
                                <div class="space-y-3 max-h-96 overflow-y-auto">
                                    {% for item in availableDrivers %}
                                        {% set driver = item.driver %}
                                        {% set stats = item.stats %}
                                        <div class="bg-white/5 border border-blue-400/20 rounded-lg p-4 hover:bg-white/10 transition">
                                            <div class="flex justify-between items-start mb-3">
                                                <div class="flex-1">
                                                    <p class="font-semibold text-white">{{ driver.firstName }} {{ driver.lastName }}</p>
                                                    <p class="text-xs text-indigo-300">{{ driver.vehicleType }}</p>
                                                </div>
                                                <div class="text-right">
                                                    <div class="flex items-center gap-1 mb-1">
                                                        <span class="text-yellow-400">⭐</span>
                                                        <span class="text-white font-semibold">{{ stats.rating }}</span>
                                                    </div>
                                                    <p class="text-xs text-indigo-300">{{ stats.completedBookings }}/{{ stats.totalBookings }}</p>
                                                </div>
                                            </div>
                                            <div class="text-xs text-indigo-300 mb-3">
                                                📍 {{ driver.plateNumber }}
                                            </div>
                                            <form action="{{ path('staff_booking_assign_driver', {id: booking.id, driverId: driver.id}) }}" method="POST" class="w-full">
                                                <input type="hidden" name="_token" value="{{ csrf_token('assign_driver_' ~ booking.id) }}">
                                                <button type="submit" class="w-full px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded transition">
                                                    Assign Driver
                                                </button>
                                            </form>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <div class="text-center text-indigo-200 py-8">
                                    <p class="text-lg font-semibold">No available drivers for the selected time slot.</p>
                                    <p class="text-sm">Please try a different time or check back later.</p>
                                </div>
                            {% endif %}
                        </div>
                                {# Assignment Feedback #}
                                {% for label, messages in app.flashes %}
                                    {% for message in messages %}
                                        <div class="my-4 px-4 py-3 rounded bg-green-600/80 text-white font-semibold shadow-lg">
                                            {{ message }}
                                        </div>
                                    {% endfor %}
                                {% endfor %}
                    {% endif %}

                    <!-- Booking Details -->
                    <div class="bg-white/10 backdrop-blur-md rounded-lg border border-white/20 p-6 shadow-xl">
                        <h3 class="text-lg font-bold text-white mb-4">📋 Booking Details</h3>
                        <div class="space-y-4 text-sm">
                            <div>
                                <p class="text-indigo-300">Type</p>
                                <p class="text-white font-semibold">{{ booking.bookingType|capitalize }}</p>
                            </div>
                            <div>
                                <p class="text-indigo-300">Priority</p>
                                <p class="text-white font-semibold">{{ booking.priorityLevel|replace({'_': ' '})|capitalize }}</p>
                            </div>
                            <div>
                                <p class="text-indigo-300">Created</p>
                                <p class="text-white">{{ booking.createdAt|date('M d, Y - H:i') }}</p>
                            </div>
                            {% if booking.updatedAt %}
                                <div>
                                    <p class="text-indigo-300">Last Updated</p>
                                    <p class="text-white">{{ booking.updatedAt|date('M d, Y - H:i') }}</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Estimated Information -->
                    {% if booking.estimatedFare or booking.estimatedDuration or booking.estimatedDistance %}
                        <div class="bg-white/10 backdrop-blur-md rounded-lg border border-white/20 p-6 shadow-xl">
                            <h3 class="text-lg font-bold text-white mb-4">💰 Estimates</h3>
                            <div class="space-y-3 text-sm">
                                {% if booking.estimatedDistance %}
                                    <div class="flex justify-between">
                                        <p class="text-indigo-300">Distance</p>
                                        <p class="text-white font-semibold">{{ booking.estimatedDistance }} km</p>
                                    </div>
                                {% endif %}
                                {% if booking.estimatedDuration %}
                                    <div class="flex justify-between">
                                        <p class="text-indigo-300">Duration</p>
                                        <p class="text-white font-semibold">{{ booking.estimatedDuration|round }} mins</p>
                                    </div>
                                {% endif %}
                                {% if booking.estimatedFare %}
                                    <div class="flex justify-between pt-3 border-t border-white/10">
                                        <p class="text-indigo-300 font-semibold">Estimated Fare</p>
                                        <p class="text-white font-bold text-lg">₱{{ booking.estimatedFare }}</p>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}

                    <!-- Action Buttons -->
                    <div class="space-y-3 flex flex-col">
                        {% if booking.status == 'pending' %}
                            <a href="{{ path('staff_booking_edit', {id: booking.id}) }}" class="block w-full px-4 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition text-center">
                                Edit Booking
                            </a>
                        {% endif %}

                        {% if booking.status not in ['completed', 'cancelled'] %}
                            <form action="{{ path('staff_booking_cancel', {id: booking.id}) }}" method="POST" class="block w-full" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('cancel_' ~ booking.id) }}">
                                <input type="hidden" name="reason" value="">
                                <button type="submit" class="w-full px-4 py-3 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg transition text-base">
                                    Cancel Booking
                                </button>
                            </form>
                        {% endif %}

                        {% if booking.status == 'pending' %}
                            <form action="{{ path('staff_booking_delete', {id: booking.id}) }}" method="POST" class="block w-full" onsubmit="return confirm('Are you sure you want to delete this booking? This cannot be undone.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ booking.id) }}">
                                <button type="submit" class="w-full px-4 py-3 bg-gray-600 hover:bg-gray-700 text-white font-semibold rounded-lg transition text-base">
                                    Delete Booking
                                </button>
                            </form>
                        {% endif %}

                        <a href="{{ path('staff_booking_index') }}" class="block w-full px-4 py-3 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-lg transition border border-white/20 text-center">
                            Back to Bookings
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
