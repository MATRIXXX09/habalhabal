{% extends 'base.html.twig' %}

{% block title %}View Vehicle - Staff{% endblock %}

{% block body %}
<div class="container mx-auto py-8 px-4 max-w-2xl">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-800">Vehicle #{{ vehicle.id }}</h1>
        <a href="{{ path('staff_vehicle_index') }}" class="text-gray-600 hover:text-gray-800">← Back</a>
    </div>

    <div class="bg-white rounded-lg shadow p-6 mb-6">
        <div class="grid grid-cols-2 gap-6">
            <div>
                <p class="text-sm text-gray-600">Plate Number</p>
                <p class="text-lg font-semibold text-gray-900">{{ vehicle.plateNumber }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-600">Type</p>
                <p class="text-gray-900">{{ vehicle.type }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-600">Model</p>
                <p class="text-gray-900">{{ vehicle.model }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-600">Capacity</p>
                <p class="text-gray-900">{{ vehicle.capacity }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-600">Current Location</p>
                <p class="text-gray-900">{{ vehicle.currentLocation ?? 'N/A' }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-600">Available</p>
                <p class="text-gray-900">{{ vehicle.isAvailable ? 'Yes' : 'No' }}</p>
            </div>
            <div>
                <p class="text-sm text-gray-600">Created</p>
                <p class="text-gray-900">{{ vehicle.createdAt|date('M d, Y - h:i A') }}</p>
            </div>
        </div>
    </div>

    <div class="flex space-x-4">
        <a href="{{ path('staff_vehicle_edit', {'id': vehicle.id}) }}" class="bg-yellow-600 hover:bg-yellow-700 text-white font-bold py-2 px-6 rounded">
            Edit
        </a>
        <form class="inline-form" method="post" action="{{ path('staff_vehicle_delete', {'id': vehicle.id}) }}" onsubmit="return confirm('Are you sure?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ vehicle.id) }}">
            <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-6 rounded">
                Delete
            </button>
        </form>
    </div>
</div>
{% endblock %}
