{% extends 'base.html.twig' %}

{% block title %}Edit Vehicle - Staff{% endblock %}

{% block body %}
<div class="container mx-auto py-8 px-4 max-w-2xl">
    <h1 class="text-3xl font-bold text-gray-800 mb-8">Edit Vehicle #{{ vehicle.id }}</h1>

    {{ form_start(form) }}
        <div class="bg-white rounded-lg shadow p-6">
            <div class="mb-6">
                {{ form_label(form.plateNumber, 'Plate Number', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(form.plateNumber, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500'}}) }}
            </div>

            <div class="mb-6">
                {{ form_label(form.type, 'Type', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(form.type, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500'}}) }}
            </div>

            <div class="mb-6">
                {{ form_label(form.model, 'Model', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(form.model, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500'}}) }}
                {% if form.model.vars.errors %}
                    <div class="text-red-600 text-sm mt-2">{{ form_errors(form.model) }}</div>
                {% endif %}
            </div>

            <div class="mb-6">
                {{ form_label(form.capacity, 'Capacity', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(form.capacity, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500'}}) }}
                {% if form.capacity.vars.errors %}
                    <div class="text-red-600 text-sm mt-2">{{ form_errors(form.capacity) }}</div>
                {% endif %}
            </div>

            <div class="flex space-x-4">
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-6 rounded">
                    Update
                </button>
                <a href="{{ path('staff_vehicle_show', {'id': vehicle.id}) }}" class="bg-gray-400 hover:bg-gray-500 text-white font-bold py-2 px-6 rounded">
                    Cancel
                </a>
            </div>
        </div>
    {{ form_end(form) }}
</div>

{% endblock %}
