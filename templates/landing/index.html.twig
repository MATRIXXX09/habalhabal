{% extends "base.html.twig" %}

{% block title %}Habal Habal - Professional Motorcycle Delivery Service{% endblock %}

{% block body %}
<div class="bg-gray-900 text-white">
    <!-- Navigation -->
    <nav class="sticky top-0 z-50 bg-gray-900/95 backdrop-blur supports-[backdrop-filter]:bg-gray-900/60 border-b border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center space-x-2">
                    <img class="h-10 w-auto" src="{{ asset('images/HABAL.png') }}" alt="Habal-habal">
                    <span class="text-xl font-bold">Habal Habal</span>
                </div>
                <div class="hidden md:flex space-x-8">
                    <a href="{{ path('app_landing') }}#features" class="hover:text-indigo-400 transition">Features</a>
                    <a href="{{ path('app_about') }}" class="hover:text-indigo-400 transition">About</a>
                    <a href="{{ path('app_contact') }}" class="hover:text-indigo-400 transition">Contact</a>
                </div>
                <div class="flex space-x-4">
                    <a href="{{ path('app_login') }}" class="text-gray-300 hover:text-white transition">Sign In</a>
                    <a href="{{ path('app_register') }}" class="bg-indigo-600 hover:bg-indigo-700 px-4 py-2 rounded-lg transition">Register</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center justify-center px-4 sm:px-6 lg:px-8 pt-20">
        <div class="absolute inset-0 bg-gradient-to-b from-indigo-900/20 to-transparent"></div>
        <div class="relative z-10 text-center max-w-4xl mx-auto">
            <h1 class="text-5xl md:text-7xl font-bold mb-6 leading-tight">
                Fast, Reliable Delivery Service
            </h1>
            <p class="text-xl md:text-2xl text-gray-300 mb-8">
                Experience the fastest motorcycle delivery service in the city. Real-time tracking, professional riders, and 24/7 availability.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="{{ path('app_register') }}" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-lg transition transform hover:scale-105">
                    Get Started
                </a>
                <a href="#features" class="border-2 border-indigo-600 hover:border-indigo-500 text-white font-bold py-3 px-8 rounded-lg transition">
                    Learn More
                </a>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-20 px-4 sm:px-6 lg:px-8 bg-gray-800/50">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-4xl md:text-5xl font-bold mb-4">Why Choose Habal Habal?</h2>
                <p class="text-gray-400 text-lg">Everything you need for reliable deliveries</p>
            </div>
            
            <div class="grid md:grid-cols-3 gap-8">
                <!-- Feature 1 -->
                <div class="bg-gray-900 p-8 rounded-xl border border-gray-700 hover:border-indigo-500 transition group">
                    <div class="bg-indigo-600 w-16 h-16 rounded-lg flex items-center justify-center mb-4 group-hover:bg-indigo-700 transition">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-3">Lightning Fast</h3>
                    <p class="text-gray-400">Average delivery time of 15-30 minutes. Professional riders trained for speed and safety.</p>
                </div>

                <!-- Feature 2 -->
                <div class="bg-gray-900 p-8 rounded-xl border border-gray-700 hover:border-indigo-500 transition group">
                    <div class="bg-indigo-600 w-16 h-16 rounded-lg flex items-center justify-center mb-4 group-hover:bg-indigo-700 transition">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-3">Live Tracking</h3>
                    <p class="text-gray-400">Track your parcel in real-time with GPS. Get instant notifications at every step of delivery.</p>
                </div>

                <!-- Feature 3 -->
                <div class="bg-gray-900 p-8 rounded-xl border border-gray-700 hover:border-indigo-500 transition group">
                    <div class="bg-indigo-600 w-16 h-16 rounded-lg flex items-center justify-center mb-4 group-hover:bg-indigo-700 transition">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-3">Professional Team</h3>
                    <p class="text-gray-400">Verified and trained riders with background checks. Courteous service and on-time delivery guaranteed.</p>
                </div>

                <!-- Feature 4 -->
                <div class="bg-gray-900 p-8 rounded-xl border border-gray-700 hover:border-indigo-500 transition group">
                    <div class="bg-indigo-600 w-16 h-16 rounded-lg flex items-center justify-center mb-4 group-hover:bg-indigo-700 transition">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-3">24/7 Support</h3>
                    <p class="text-gray-400">Round-the-clock customer support. Available anytime you need us, any day of the week.</p>
                </div>

                <!-- Feature 5 -->
                <div class="bg-gray-900 p-8 rounded-xl border border-gray-700 hover:border-indigo-500 transition group">
                    <div class="bg-indigo-600 w-16 h-16 rounded-lg flex items-center justify-center mb-4 group-hover:bg-indigo-700 transition">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-3">Transparent Pricing</h3>
                    <p class="text-gray-400">Competitive rates with no hidden fees. Flat rates, distance-based, or hourly options available.</p>
                </div>

                <!-- Feature 6 -->
                <div class="bg-gray-900 p-8 rounded-xl border border-gray-700 hover:border-indigo-500 transition group">
                    <div class="bg-indigo-600 w-16 h-16 rounded-lg flex items-center justify-center mb-4 group-hover:bg-indigo-700 transition">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-3">Secure & Safe</h3>
                    <p class="text-gray-400">Insured deliveries. Your parcel is handled with care and arrives safely at its destination.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- How It Works Section -->
    <section id="how-it-works" class="py-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-4xl md:text-5xl font-bold mb-4">How It Works</h2>
                <p class="text-gray-400 text-lg">Three simple steps to get your delivery done</p>
            </div>

            <div class="grid md:grid-cols-3 gap-12">
                <div class="text-center">
                    <div class="bg-indigo-600 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6 text-2xl font-bold">1</div>
                    <h3 class="text-2xl font-bold mb-3">Place Order</h3>
                    <p class="text-gray-400">Open the app, enter your pickup and delivery locations, and confirm your order in seconds.</p>
                </div>
                <div class="text-center">
                    <div class="bg-indigo-600 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6 text-2xl font-bold">2</div>
                    <h3 class="text-2xl font-bold mb-3">Rider Assigned</h3>
                    <p class="text-gray-400">A professional rider is instantly assigned to your delivery and heads to your pickup location.</p>
                </div>
                <div class="text-center">
                    <div class="bg-indigo-600 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6 text-2xl font-bold">3</div>
                    <h3 class="text-2xl font-bold mb-3">Delivered</h3>
                    <p class="text-gray-400">Track your delivery in real-time and receive confirmation when your parcel arrives safely.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-950 border-t border-gray-800 py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
            <div class="grid md:grid-cols-4 gap-8 mb-8">
                <div>
                    <div class="flex items-center space-x-2 mb-4">
                        <img class="h-8 w-auto" src="{{ asset('images/HABAL.png') }}" alt="Habal-habal">
                        <span class="font-bold">Habal Habal</span>
                    </div>
                    <p class="text-gray-400 text-sm">Fast and reliable motorcycle delivery service.</p>
                </div>
                <div>
                    <h4 class="font-bold mb-4">Quick Links</h4>
                    <ul class="space-y-2 text-gray-400 text-sm">
                        <li><a href="#features" class="hover:text-white transition">Features</a></li>
                        <li><a href="#about" class="hover:text-white transition">About</a></li>
                        <li><a href="{{ path('app_login') }}" class="hover:text-white transition">Sign In</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-bold mb-4">Support</h4>
                    <ul class="space-y-2 text-gray-400 text-sm">
                        <li><a href="#contact" class="hover:text-white transition">Contact Us</a></li>
                        <li><a href="#" class="hover:text-white transition">FAQ</a></li>
                        <li><a href="#" class="hover:text-white transition">Help Center</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-bold mb-4">Legal</h4>
                    <ul class="space-y-2 text-gray-400 text-sm">
                        <li><a href="#" class="hover:text-white transition">Privacy Policy</a></li>
                        <li><a href="#" class="hover:text-white transition">Terms of Service</a></li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-gray-800 pt-8">
                <p class="text-center text-gray-500 text-sm">&copy; 2026 Habal Habal Management System. All rights reserved.</p>
            </div>
        </div>
    </footer>
</div>

<script>
// Smooth scrolling for anchor links
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
        }
    });
});
</script>
{% endblock %}
