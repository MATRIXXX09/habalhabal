{% extends "base.html.twig" %}

{% block title %}About Us - Habal Habal Management System{% endblock %}

{% block body %}
<div class="bg-gray-900 text-white">
    <!-- Navigation -->
    <nav class="sticky top-0 z-50 bg-gray-900/95 backdrop-blur supports-[backdrop-filter]:bg-gray-900/60 border-b border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center space-x-2">
                    <img class="h-10 w-auto" src="{{ asset('images/HABAL.png') }}" alt="Habal-habal">
                    <span class="text-xl font-bold">Habal Habal</span>
                </div>
                <div class="hidden md:flex space-x-8">
                    <a href="{{ path('app_landing') }}" class="hover:text-indigo-400 transition">Home</a>
                    <a href="{{ path('app_about') }}" class="text-indigo-400">About</a>
                    <a href="{{ path('app_contact') }}" class="hover:text-indigo-400 transition">Contact</a>
                </div>
                <div class="flex space-x-4">
                    <a href="{{ path('app_login') }}" class="text-gray-300 hover:text-white transition">Sign In</a>
                    <a href="{{ path('app_register') }}" class="bg-indigo-600 hover:bg-indigo-700 px-4 py-2 rounded-lg transition">Register</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="relative py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-indigo-900/20 to-transparent">
        <div class="max-w-4xl mx-auto text-center">
            <h1 class="text-5xl md:text-6xl font-bold mb-6">About Habal Habal</h1>
            <p class="text-xl text-gray-300">
                Revolutionizing last-mile delivery with fast, reliable, and professional motorcycle delivery services.
            </p>
        </div>
    </section>

    <!-- Our Story Section -->
    <section class="py-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-4xl font-bold mb-8">Our Story</h2>
            <div class="space-y-6 text-gray-300 text-lg">
                <p>
                    Founded in 2020, Habal Habal emerged from a simple observation: the city needed a faster, 
                    more efficient delivery solution. Traditional delivery methods were slow, expensive, and often unreliable. 
                    We saw an opportunity to revolutionize the delivery industry using motorcycle couriers.
                </p>
                <p>
                    What started as a small team of 5 riders has grown into a thriving platform serving thousands of customers 
                    daily. Our commitment to speed, reliability, and professionalism has made us a trusted name in the delivery business.
                </p>
                <p>
                    Today, we operate with cutting-edge tracking technology, a network of verified professional riders, and 
                    round-the-clock customer support. Every day, we help businesses and individuals get their parcels delivered 
                    faster than ever before.
                </p>
            </div>
        </div>
    </section>

    <!-- Mission & Vision Section -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-gray-800/50">
        <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12">
            <div>
                <h2 class="text-3xl font-bold mb-6">Our Mission</h2>
                <p class="text-gray-300 text-lg">
                    To provide the fastest, most reliable, and most affordable delivery service in the city. 
                    We aim to empower businesses with efficient logistics while creating opportunities for professional riders.
                </p>
            </div>
            <div>
                <h2 class="text-3xl font-bold mb-6">Our Vision</h2>
                <p class="text-gray-300 text-lg">
                    To become the leading motorcycle delivery platform in Southeast Asia, known for innovation, reliability, 
                    and exceptional customer service. We envision a logistics ecosystem where speed and professionalism are guaranteed.
                </p>
            </div>
        </div>
    </section>

    <!-- Meet the Team Section -->
    <section id="team" class="py-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-bold mb-4">Meet the Team</h2>
                <p class="text-gray-400 text-lg">The talented people behind your fast deliveries</p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <!-- Team Member 1 -->
                <div class="bg-gray-800 rounded-xl overflow-hidden hover:transform hover:scale-105 transition duration-300">
                    <div class="h-64 bg-gradient-to-br from-indigo-600 to-indigo-800 flex items-center justify-center">
                        <svg class="w-32 h-32 text-indigo-200" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </svg>
                    </div>
                    <div class="p-6">
                        <h3 class="text-2xl font-bold mb-2">Maria Santos</h3>
                        <p class="text-indigo-400 font-semibold mb-3">Chief Executive Officer</p>
                        <p class="text-gray-400">
                            Visionary leader with 10+ years in logistics and delivery management. 
                            Driving Habal Habal's mission to revolutionize city delivery.
                        </p>
                    </div>
                </div>

                <!-- Team Member 2 -->
                <div class="bg-gray-800 rounded-xl overflow-hidden hover:transform hover:scale-105 transition duration-300">
                    <div class="h-64 bg-gradient-to-br from-indigo-600 to-indigo-800 flex items-center justify-center">
                        <svg class="w-32 h-32 text-indigo-200" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </svg>
                    </div>
                    <div class="p-6">
                        <h3 class="text-2xl font-bold mb-2">Juan Dela Cruz</h3>
                        <p class="text-indigo-400 font-semibold mb-3">Chief Technology Officer</p>
                        <p class="text-gray-400">
                            Tech innovator with 12+ years of software development experience. 
                            Building the platform that powers fast delivery tracking and management.
                        </p>
                    </div>
                </div>

                <!-- Team Member 3 -->
                <div class="bg-gray-800 rounded-xl overflow-hidden hover:transform hover:scale-105 transition duration-300">
                    <div class="h-64 bg-gradient-to-br from-indigo-600 to-indigo-800 flex items-center justify-center">
                        <svg class="w-32 h-32 text-indigo-200" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </svg>
                    </div>
                    <div class="p-6">
                        <h3 class="text-2xl font-bold mb-2">Anna Reyes</h3>
                        <p class="text-indigo-400 font-semibold mb-3">Chief Operations Officer</p>
                        <p class="text-gray-400">
                            Operations expert with 8+ years managing networks and rider operations. 
                            Ensuring every delivery exceeds customer expectations.
                        </p>
                    </div>
                </div>

                <!-- Team Member 4 -->
                <div class="bg-gray-800 rounded-xl overflow-hidden hover:transform hover:scale-105 transition duration-300">
                    <div class="h-64 bg-gradient-to-br from-indigo-600 to-indigo-800 flex items-center justify-center">
                        <svg class="w-32 h-32 text-indigo-200" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </svg>
                    </div>
                    <div class="p-6">
                        <h3 class="text-2xl font-bold mb-2">Robert Garcia</h3>
                        <p class="text-indigo-400 font-semibold mb-3">Head of Customer Support</p>
                        <p class="text-gray-400">
                            Customer service leader with 6+ years experience. Building support teams 
                            that make customers feel valued and heard.
                        </p>
                    </div>
                </div>

                <!-- Team Member 5 -->
                <div class="bg-gray-800 rounded-xl overflow-hidden hover:transform hover:scale-105 transition duration-300">
                    <div class="h-64 bg-gradient-to-br from-indigo-600 to-indigo-800 flex items-center justify-center">
                        <svg class="w-32 h-32 text-indigo-200" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </svg>
                    </div>
                    <div class="p-6">
                        <h3 class="text-2xl font-bold mb-2">Lisa Romero</h3>
                        <p class="text-indigo-400 font-semibold mb-3">Head of Business Development</p>
                        <p class="text-gray-400">
                            Strategic growth expert with 9+ years in business expansion. 
                            Expanding Habal Habal's reach and partnerships.
                        </p>
                    </div>
                </div>

                <!-- Team Member 6 -->
                <div class="bg-gray-800 rounded-xl overflow-hidden hover:transform hover:scale-105 transition duration-300">
                    <div class="h-64 bg-gradient-to-br from-indigo-600 to-indigo-800 flex items-center justify-center">
                        <svg class="w-32 h-32 text-indigo-200" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </svg>
                    </div>
                    <div class="p-6">
                        <h3 class="text-2xl font-bold mb-2">Miguel Torres</h3>
                        <p class="text-indigo-400 font-semibold mb-3">Head of Finance</p>
                        <p class="text-gray-400">
                            Finance expert with 7+ years managing company finances and budgets. 
                            Ensuring sustainable growth and profitability.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Values Section -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-gray-800/50">
        <div class="max-w-6xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-bold mb-4">Our Core Values</h2>
            </div>

            <div class="grid md:grid-cols-4 gap-8">
                <div class="text-center">
                    <div class="bg-indigo-600 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">Speed</h3>
                    <p class="text-gray-400">Delivering faster than anyone else in the city.</p>
                </div>

                <div class="text-center">
                    <div class="bg-indigo-600 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">Reliability</h3>
                    <p class="text-gray-400">Always on time, always dependable.</p>
                </div>

                <div class="text-center">
                    <div class="bg-indigo-600 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">Professionalism</h3>
                    <p class="text-gray-400">Trained, verified, and courteous riders.</p>
                </div>

                <div class="text-center">
                    <div class="bg-indigo-600 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12a9 9 0 11-18 0 9 9 0 0118 0m-9 5h.01"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">Innovation</h3>
                    <p class="text-gray-400">Leveraging technology for better service.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-4xl font-bold mb-6">Ready to Experience Fast Delivery?</h2>
            <p class="text-xl text-gray-300 mb-8">Join hundreds of satisfied customers using Habal Habal daily.</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="{{ path('app_register') }}" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-lg transition">
                    Get Started Now
                </a>
                <a href="{{ path('app_contact') }}" class="border-2 border-indigo-600 hover:border-indigo-500 text-white font-bold py-3 px-8 rounded-lg transition">
                    Contact Us
                </a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-950 border-t border-gray-800 py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
            <div class="text-center">
                <p class="text-gray-500 text-sm">&copy; 2026 Habal Habal Management System. All rights reserved.</p>
            </div>
        </div>
    </footer>
</div>
{% endblock %}
