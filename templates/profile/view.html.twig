{% extends 'base.html.twig' %}

{% block title %}My Profile - Admin Panel{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900">
    {{ include('admin/_sidebar.html.twig') }}

    <main class="pl-72">
        <div class="px-8 py-6">
            <!-- Header -->
            <div class="mb-8">
                <h1 class="text-3xl font-bold text-white mb-2">My Profile</h1>
                <p class="text-gray-400">View and manage your account information</p>
            </div>

            <!-- Profile Card -->
            <div class="max-w-2xl">
                <div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl shadow-lg overflow-hidden">
                    <!-- Header -->
                    <div class="bg-gradient-to-r from-indigo-500/10 to-purple-500/10 px-6 py-4 border-b border-gray-700/50">
                        <div class="flex items-center gap-4">
                            <div class="h-16 w-16 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white text-2xl font-bold shadow-lg">
                                {{ user.email|slice(0, 1)|upper }}
                            </div>
                            <div>
                                <h2 class="text-xl font-semibold text-white">{{ user.email }}</h2>
                                <div class="flex items-center gap-2 mt-1">
                                    {% for role in user.roles %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gradient-to-r from-indigo-500/20 to-purple-500/20 text-indigo-300">
                                            {{ role|replace({'ROLE_': ''}) }}
                                        </span>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Account Info -->
                    <div class="p-6 space-y-6">
                        <!-- Email -->
                        <div>
                            <label class="text-sm font-semibold text-gray-300">Email Address</label>
                            <div class="mt-2 p-3 bg-gray-700/30 rounded-lg border border-gray-600/50">
                                <p class="text-white">{{ user.email }}</p>
                            </div>
                        </div>

                        <!-- Roles -->
                        <div>
                            <label class="text-sm font-semibold text-gray-300">Account Roles</label>
                            <div class="mt-2 p-3 bg-gray-700/30 rounded-lg border border-gray-600/50">
                                {% if user.roles %}
                                    <div class="flex flex-wrap gap-2">
                                        {% for role in user.roles %}
                                            <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-gradient-to-r from-indigo-500/20 to-purple-500/20 text-indigo-300 ring-1 ring-inset ring-indigo-500/30">
                                                {{ role|replace({'ROLE_': ''}) }}
                                            </span>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <p class="text-gray-400">No roles assigned</p>
                                {% endif %}
                            </div>
                        </div>

                        <!-- Verification Status -->
                        <div>
                            <label class="text-sm font-semibold text-gray-300">Account Status</label>
                            <div class="mt-2 p-3 bg-gray-700/30 rounded-lg border border-gray-600/50">
                                {% if user.isVerified %}
                                    <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-gradient-to-r from-green-500/20 to-emerald-500/20 text-green-300 ring-1 ring-inset ring-green-500/30">
                                        ✓ Verified
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-gradient-to-r from-yellow-500/20 to-orange-500/20 text-yellow-300 ring-1 ring-inset ring-yellow-500/30">
                                        ⏳ Not Verified
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="border-t border-gray-700/50 pt-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <a href="{{ path('app_profile_change_password') }}" class="flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-indigo-500 to-purple-600 text-white rounded-lg hover:opacity-90 transition-all duration-200 shadow-lg hover:shadow-xl">
                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                    </svg>
                                    Change Password
                                </a>
                                <a href="{{ path('app_logout') }}" class="flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-red-500 to-pink-600 text-white rounded-lg hover:opacity-90 transition-all duration-200 shadow-lg hover:shadow-xl">
                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                    </svg>
                                    Logout
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Info Box -->
                <div class="mt-6 p-4 bg-blue-500/10 border border-blue-500/30 rounded-lg">
                    <div class="flex gap-3">
                        <svg class="h-5 w-5 text-blue-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 5v8a2 2 0 01-2 2h-5l-5 4v-4H4a2 2 0 01-2-2V5a2 2 0 012-2h12a2 2 0 012 2zm-11-1a1 1 0 11-2 0 1 1 0 012 0zM8 9a1 1 0 100-2 1 1 0 000 2zm4 0a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                        </svg>
                        <p class="text-sm text-blue-300">
                            To edit your email or roles, contact your system administrator.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
