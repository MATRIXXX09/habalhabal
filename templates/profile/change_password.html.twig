{% extends 'base.html.twig' %}

{% block title %}Change Password - Admin Panel{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900">
    {{ include('admin/_sidebar.html.twig') }}

    <main class="pl-72">
        <div class="px-8 py-6">
            <!-- Header -->
            <div class="mb-8">
                <a href="{{ path('app_profile_view') }}" class="inline-flex items-center gap-2 text-indigo-400 hover:text-indigo-300 mb-4">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Back to Profile
                </a>
                <h1 class="text-3xl font-bold text-white mb-2">Change Password</h1>
                <p class="text-gray-400">Update your account password</p>
            </div>

            <!-- Change Password Form -->
            <div class="max-w-2xl">
                <div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl shadow-lg overflow-hidden">
                    <!-- Header -->
                    <div class="bg-gradient-to-r from-indigo-500/10 to-purple-500/10 px-6 py-4 border-b border-gray-700/50">
                        <h2 class="text-lg font-semibold text-white">Security Settings</h2>
                    </div>

                    <!-- Form -->
                    <form method="POST" class="p-6 space-y-6">
                        <!-- CSRF Token -->
                        <input type="hidden" name="_token" value="{{ csrf_token('change_password') }}">

                        <!-- Success Message -->
                        {% if success %}
                            <div class="rounded-lg bg-gradient-to-r from-green-500/10 to-emerald-500/10 p-4 border border-green-500/30 shadow-lg">
                                <div class="flex items-center gap-3">
                                    <svg class="h-6 w-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    <p class="text-sm font-medium text-green-300">Password changed successfully!</p>
                                </div>
                            </div>
                        {% endif %}

                        <!-- Error Message -->
                        {% if error %}
                            <div class="rounded-lg bg-gradient-to-r from-red-500/10 to-pink-500/10 p-4 border border-red-500/30 shadow-lg">
                                <div class="flex items-center gap-3">
                                    <svg class="h-6 w-6 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    <p class="text-sm font-medium text-red-300">{{ error }}</p>
                                </div>
                            </div>
                        {% endif %}

                        <!-- Current Password -->
                        <div>
                            <label for="current_password" class="block text-sm font-semibold text-gray-300 mb-2">
                                Current Password
                            </label>
                            <input
                                type="password"
                                id="current_password"
                                name="current_password"
                                required
                                class="w-full px-4 py-3 rounded-lg bg-gray-700/30 border border-gray-600/50 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-transparent transition-all"
                                placeholder="Enter your current password"
                            >
                            <p class="text-xs text-gray-400 mt-1">We need your current password to verify your identity</p>
                        </div>

                        <!-- New Password -->
                        <div>
                            <label for="new_password" class="block text-sm font-semibold text-gray-300 mb-2">
                                New Password
                            </label>
                            <input
                                type="password"
                                id="new_password"
                                name="new_password"
                                required
                                minlength="6"
                                class="w-full px-4 py-3 rounded-lg bg-gray-700/30 border border-gray-600/50 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-transparent transition-all"
                                placeholder="Enter your new password (minimum 6 characters)"
                            >
                            <p class="text-xs text-gray-400 mt-1">At least 6 characters</p>
                        </div>

                        <!-- Confirm Password -->
                        <div>
                            <label for="confirm_password" class="block text-sm font-semibold text-gray-300 mb-2">
                                Confirm New Password
                            </label>
                            <input
                                type="password"
                                id="confirm_password"
                                name="confirm_password"
                                required
                                minlength="6"
                                class="w-full px-4 py-3 rounded-lg bg-gray-700/30 border border-gray-600/50 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-transparent transition-all"
                                placeholder="Re-enter your new password"
                            >
                        </div>

                        <!-- Password Requirements -->
                        <div class="p-4 bg-gray-700/20 border border-gray-600/30 rounded-lg">
                            <p class="text-sm font-semibold text-gray-300 mb-2">Password Requirements:</p>
                            <ul class="text-xs text-gray-400 space-y-1">
                                <li>✓ At least 6 characters long</li>
                                <li>✓ Different from current password</li>
                                <li>✓ Both new password fields must match</li>
                            </ul>
                        </div>

                        <!-- Action Buttons -->
                        <div class="border-t border-gray-700/50 pt-6 flex gap-4">
                            <button
                                type="submit"
                                class="flex-1 px-4 py-3 bg-gradient-to-r from-indigo-500 to-purple-600 text-white rounded-lg hover:opacity-90 transition-all duration-200 shadow-lg hover:shadow-xl font-semibold flex items-center justify-center gap-2"
                            >
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                Update Password
                            </button>
                            <a
                                href="{{ path('app_profile_view') }}"
                                class="flex-1 px-4 py-3 bg-gray-700/30 border border-gray-600/50 text-gray-300 rounded-lg hover:bg-gray-700/50 transition-all duration-200 font-semibold flex items-center justify-center gap-2"
                            >
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>

                <!-- Security Tips -->
                <div class="mt-6 p-4 bg-blue-500/10 border border-blue-500/30 rounded-lg">
                    <div class="flex gap-3">
                        <svg class="h-5 w-5 text-blue-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <div class="text-sm text-blue-300">
                            <p class="font-semibold mb-1">Security Tip:</p>
                            <p>Use a strong password with a mix of uppercase, lowercase, numbers, and special characters for better security.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
