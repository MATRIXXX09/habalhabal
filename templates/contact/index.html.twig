{% extends "base.html.twig" %}

{% block title %}Contact Us - Habal Habal Management System{% endblock %}

{% block body %}
<div class="bg-gradient-to-b from-black via-gray-900 to-black text-white">
    <!-- Navigation -->
    <nav class="sticky top-0 z-50 bg-black/95 backdrop-blur-md supports-[backdrop-filter]:bg-black/70 border-b border-red-500/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center space-x-3">
                    <img class="h-10 w-auto" src="{{ asset('images/HABAL.png') }}" alt="Habal-habal">
                    <span class="text-2xl font-bold bg-gradient-to-r from-green-400 to-red-500 bg-clip-text text-transparent">Habal Habal</span>
                </div>
                
                <!-- Mobile Menu Button -->
                <button id="mobile-menu-btn" class="md:hidden text-gray-300 hover:text-green-400 p-2">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
                
                <!-- Desktop Navigation -->
                <div class="hidden md:flex items-center space-x-8">
                    <a href="{{ path('app_landing') }}" class="text-gray-300 hover:text-green-400 transition duration-300">Home</a>
                    <a href="{{ path('app_about') }}" class="text-gray-300 hover:text-green-400 transition duration-300">About</a>
                    <a href="{{ path('app_contact') }}" class="text-green-400 hover:text-green-300 transition duration-300">Contact</a>
                    <a href="{{ path('app_login') }}" class="text-gray-300 hover:text-green-400 transition duration-300 px-4 py-2">Sign In</a>
                    <a href="{{ path('app_register') }}" class="bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-semibold px-6 py-2 rounded-lg transition duration-300 shadow-lg shadow-red-600/30">Register</a>
                </div>
            </div>
            
            <!-- Mobile Navigation Menu -->
            <div id="mobile-menu" class="hidden md:hidden pb-4 pt-2 border-t border-gray-800/50">
                <a href="{{ path('app_landing') }}" class="block text-gray-300 hover:text-green-400 py-2 px-4 rounded transition">Home</a>
                <a href="{{ path('app_about') }}" class="block text-gray-300 hover:text-green-400 py-2 px-4 rounded transition">About</a>
                <a href="{{ path('app_contact') }}" class="block text-green-400 py-2 px-4 rounded transition">Contact</a>
                <div class="flex flex-col gap-2 mt-4 pt-4 border-t border-gray-800/50">
                    <a href="{{ path('app_login') }}" class="block text-center text-gray-300 hover:text-green-400 py-2 px-4">Sign In</a>
                    <a href="{{ path('app_register') }}" class="block text-center bg-gradient-to-r from-red-600 to-red-700 text-white font-semibold py-2 px-4 rounded-lg">Register</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="relative py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-green-900/20 to-transparent">
        <div class="max-w-4xl mx-auto text-center">
            <h1 class="text-5xl md:text-6xl font-bold mb-6">Get In Touch</h1>
            <p class="text-xl text-gray-300">
                We'd love to hear from you. Send us a message and we'll respond as soon as possible.
            </p>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="py-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto">
            <div class="grid md:grid-cols-3 gap-12 mb-16">
                <!-- Contact Info Card 1 -->
                <div class="text-center">
                    <div class="bg-gradient-to-r from-green-600 to-emerald-600 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg shadow-green-600/50">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">Email</h3>
                    <p class="text-gray-400">support@habalhabal.com</p>
                    <p class="text-gray-500 text-sm mt-2">We'll respond within 24 hours</p>
                </div>

                <!-- Contact Info Card 2 -->
                <div class="text-center">
                    <div class="bg-gradient-to-r from-green-600 to-emerald-600 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg shadow-green-600/50">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 00.948-.684l1.498-4.493a1 1 0 011.502-.684l1.498 4.493a1 1 0 00.948.684H19a2 2 0 012 2v1a2 2 0 01-2 2H5a2 2 0 01-2-2V5z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">Phone</h3>
                    <p class="text-gray-400">+63 (123) 456-7890</p>
                    <p class="text-gray-500 text-sm mt-2">Available 7 days a week</p>
                </div>

                <!-- Contact Info Card 3 -->
                <div class="text-center">
                    <div class="bg-gradient-to-r from-green-600 to-emerald-600 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg shadow-green-600/50">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">Location</h3>
                    <p class="text-gray-400">Metro Manila, Philippines</p>
                    <p class="text-gray-500 text-sm mt-2">Headquarters & Operations Center</p>
                </div>
            </div>

            <!-- Contact Form and Hours -->
            <div class="grid md:grid-cols-2 gap-16">
                <!-- Contact Form -->
                <div class="bg-gray-800/50 rounded-xl p-8 border border-green-900/30">
                    <h2 class="text-2xl font-bold mb-6">Send us a Message</h2>
                    
                    {% if success %}
                        <div class="mb-6 bg-green-900/30 border border-green-600 text-green-300 px-4 py-3 rounded-lg">
                            <p class="font-semibold">✓ Thank you!</p>
                            <p>Your message has been sent successfully. We'll get back to you within 24 hours.</p>
                        </div>
                    {% endif %}
                    
                    {% if error %}
                        <div class="mb-6 bg-red-900/30 border border-red-600 text-red-300 px-4 py-3 rounded-lg">
                            <p class="font-semibold">✕ Error</p>
                            <p>{{ error }}</p>
                        </div>
                    {% endif %}
                    
                    <form class="space-y-6" method="POST" action="{{ path('app_contact') }}">
                        <div>
                            <label class="block text-sm font-semibold mb-2">Full Name</label>
                            <input 
                                type="text" 
                                name="name" 
                                required
                                class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg focus:outline-none focus:border-green-500 text-white placeholder-gray-500" 
                                placeholder="Your Name"
                            >
                        </div>

                        <div>
                            <label class="block text-sm font-semibold mb-2">Email Address</label>
                            <input 
                                type="email" 
                                name="email" 
                                required
                                class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg focus:outline-none focus:border-green-500 text-white placeholder-gray-500" 
                                placeholder="your.email@example.com"
                            >
                        </div>

                        <div>
                            <label class="block text-sm font-semibold mb-2">Phone (Optional)</label>
                            <input 
                                type="tel" 
                                name="phone" 
                                class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg focus:outline-none focus:border-green-500 text-white placeholder-gray-500" 
                                placeholder="+63 (123) 456-7890"
                            >
                        </div>

                        <div>
                            <label class="block text-sm font-semibold mb-2">Subject</label>
                            <select 
                                name="subject" 
                                required
                                class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg focus:outline-none focus:border-green-500 text-white"
                            >
                                <option value="">Select a subject...</option>
                                <option value="Delivery Inquiry">Delivery Inquiry</option>
                                <option value="Customer Support">Customer Support</option>
                                <option value="Partnership Inquiry">Partnership Inquiry</option>
                                <option value="Careers">Careers</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold mb-2">Message</label>
                            <textarea 
                                name="message" 
                                required
                                rows="5"
                                class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg focus:outline-none focus:border-green-500 text-white placeholder-gray-500 resize-none" 
                                placeholder="Tell us how we can help..."
                            ></textarea>
                        </div>

                        <button 
                            type="submit"
                            class="w-full bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white font-bold py-3 rounded-lg transition duration-200 shadow-lg hover:shadow-xl"
                        >
                            Send Message
                        </button>
                    </form>
                </div>

                <!-- Business Hours and Info -->
                <div>
                    <div class="bg-gray-800/50 rounded-xl p-8 border border-gray-700 mb-8">
                        <h2 class="text-2xl font-bold mb-6">Business Hours</h2>
                        <div class="space-y-4">
                            <div class="flex justify-between">
                                <span class="text-gray-400">Monday - Friday</span>
                                <span class="font-semibold">7:00 AM - 10:00 PM</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-400">Saturday</span>
                                <span class="font-semibold">8:00 AM - 10:00 PM</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-400">Sunday</span>
                                <span class="font-semibold">8:00 AM - 9:00 PM</span>
                            </div>
                            <div class="flex justify-between pt-4 border-t border-gray-700">
                                <span class="text-gray-400">Delivery Services</span>
                                <span class="font-semibold">24/7</span>
                            </div>
                        </div>
                    </div>

                    <div class="bg-gradient-to-br from-green-600/20 to-green-900/20 rounded-xl p-8 border border-green-500/30">
                        <h3 class="text-xl font-bold mb-4">Emergency Support</h3>
                        <p class="text-gray-300 mb-4">
                            Need immediate assistance? Our emergency support team is available 24/7 for urgent delivery issues.
                        </p>
                        <a href="tel:+63-123-456-7890" class="inline-block bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white font-bold py-2 px-6 rounded-lg transition shadow-lg">
                            Call Emergency Line
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-gray-800/50">
        <div class="max-w-4xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-bold mb-4">Frequently Asked Questions</h2>
                <p class="text-gray-400">Can't find the answer you're looking for? Feel free to contact us.</p>
            </div>

            <div class="space-y-6">
                <!-- FAQ Item 1 -->
                <details class="group cursor-pointer">
                    <summary class="flex justify-between items-center bg-gray-900 p-6 rounded-lg hover:bg-gray-800/80 transition">
                        <span class="font-semibold text-lg">How quickly can you deliver my order?</span>
                        <span class="text-green-400 transition group-open:rotate-180">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                            </svg>
                        </span>
                    </summary>
                    <div class="bg-gray-900/50 p-6 border-t border-gray-700">
                        <p class="text-gray-300">
                            Most deliveries within Metro Manila are completed within 30-60 minutes. We offer express delivery (15-30 minutes) 
                            for urgent orders and scheduled delivery for planned shipments. Delivery times may vary based on traffic conditions and location.
                        </p>
                    </div>
                </details>

                <!-- FAQ Item 2 -->
                <details class="group cursor-pointer">
                    <summary class="flex justify-between items-center bg-gray-900 p-6 rounded-lg hover:bg-gray-800/80 transition">
                        <span class="font-semibold text-lg">What items can I send with Habal Habal?</span>
                        <span class="text-green-400 transition group-open:rotate-180">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                            </svg>
                        </span>
                    </summary>
                    <div class="bg-gray-900/50 p-6 border-t border-gray-700">
                        <p class="text-gray-300">
                            We deliver most items including documents, parcels, food, and retail goods. However, we cannot deliver hazardous materials, 
                            perishables without proper packaging, or items exceeding 50kg. For special items, please contact our support team for confirmation.
                        </p>
                    </div>
                </details>

                <!-- FAQ Item 3 -->
                <details class="group cursor-pointer">
                    <summary class="flex justify-between items-center bg-gray-900 p-6 rounded-lg hover:bg-gray-800/80 transition">
                        <span class="font-semibold text-lg">How do I track my delivery?</span>
                        <span class="text-green-400 transition group-open:rotate-180">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                            </svg>
                        </span>
                    </summary>
                    <div class="bg-gray-900/50 p-6 border-t border-gray-700">
                        <p class="text-gray-300">
                            After you place an order, you can track your delivery in real-time through our mobile app or web dashboard. 
                            You'll receive a tracking link via email and SMS with live location updates of your rider.
                        </p>
                    </div>
                </details>

                <!-- FAQ Item 4 -->
                <details class="group cursor-pointer">
                    <summary class="flex justify-between items-center bg-gray-900 p-6 rounded-lg hover:bg-gray-800/80 transition">
                        <span class="font-semibold text-lg">What if my delivery is late or lost?</span>
                        <span class="text-green-400 transition group-open:rotate-180">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                            </svg>
                        </span>
                    </summary>
                    <div class="bg-gray-900/50 p-6 border-t border-gray-700">
                        <p class="text-gray-300">
                            We guarantee on-time delivery. If your order is late, we'll provide a full refund or credit. For lost items, 
                            our insurance covers up to the declared value. Contact our support team immediately with your tracking number.
                        </p>
                    </div>
                </details>

                <!-- FAQ Item 5 -->
                <details class="group cursor-pointer">
                    <summary class="flex justify-between items-center bg-gray-900 p-6 rounded-lg hover:bg-gray-800/80 transition">
                        <span class="font-semibold text-lg">Are your riders insured?</span>
                        <span class="text-green-400 transition group-open:rotate-180">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                            </svg>
                        </span>
                    </summary>
                    <div class="bg-gray-900/50 p-6 border-t border-gray-700">
                        <p class="text-gray-300">
                            Yes! All our riders are fully insured. Additionally, every delivery includes cargo insurance to protect your items. 
                            You can optionally purchase additional premium insurance for high-value items.
                        </p>
                    </div>
                </details>

                <!-- FAQ Item 6 -->
                <details class="group cursor-pointer">
                    <summary class="flex justify-between items-center bg-gray-900 p-6 rounded-lg hover:bg-gray-800/80 transition">
                        <span class="font-semibold text-lg">How much does delivery cost?</span>
                        <span class="text-green-400 transition group-open:rotate-180">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                            </svg>
                        </span>
                    </summary>
                    <div class="bg-gray-900/50 p-6 border-t border-gray-700">
                        <p class="text-gray-300">
                            Delivery fees start at ₱99 for standard delivery within Metro Manila. Express delivery costs ₱199, and scheduled 
                            delivery is negotiable based on your needs. Use our quotation tool to get an instant estimate.
                        </p>
                    </div>
                </details>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-4xl font-bold mb-6">Still Have Questions?</h2>
            <p class="text-xl text-gray-300 mb-8">Our team is here to help. Feel free to reach out using the form above or call us directly.</p>
            <a href="#contact-form" class="inline-block bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white font-bold py-3 px-8 rounded-lg transition shadow-lg">
                Send us a Message
            </a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-black border-t border-gray-800 py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
            <div class="text-center">
                <p class="text-gray-500 text-sm">&copy; 2026 Habal Habal Management System. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
    // Mobile menu toggle
    document.addEventListener('DOMContentLoaded', function() {
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        if (mobileMenuBtn) {
            mobileMenuBtn.addEventListener('click', function() {
                mobileMenu.classList.toggle('hidden');
            });

            // Close menu when a link is clicked
            mobileMenu.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', function() {
                    mobileMenu.classList.add('hidden');
                });
            });
        }
    });
    </script>
</div>
{% endblock %}






