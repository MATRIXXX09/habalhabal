{% extends 'base.html.twig' %}

{% block title %}Activity Logs - Admin{% endblock %}

{% block body %}
<div class="min-h-full bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900">
    {{ include('admin/_sidebar.html.twig') }}

    <main class="pl-72">
        <div class="px-8 py-6">
            <!-- Header -->
            <div class="mb-8">
                <h1 class="text-3xl font-bold text-white mb-2">Activity Logs</h1>
                <p class="text-gray-400">View and filter all system activities</p>
            </div>

            <!-- Filter Form -->
            <div class="mb-8 bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-lg p-6">
                <form method="get" class="grid grid-cols-1 gap-4 sm:grid-cols-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">User</label>
                        <input 
                            type="text" 
                            name="user" 
                            value="{{ filterUser }}"
                            placeholder="Filter by email..."
                            class="w-full rounded-md bg-gray-700 px-3 py-2 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                        >
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">Action</label>
                        <select name="action" class="w-full rounded-md bg-gray-700 px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 [&_option]:bg-gray-800 [&_option]:text-white">
                            <option value="">All Actions</option>
                            {% for action in actions %}
                                <option value="{{ action }}" {% if filterAction == action %}selected{% endif %}>
                                    {{ action }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">From Date</label>
                        <input 
                            type="date" 
                            name="date_from" 
                            value="{{ filterDateFrom }}"
                            class="w-full rounded-md bg-gray-700 px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
                        >
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">To Date</label>
                        <input 
                            type="date" 
                            name="date_to" 
                            value="{{ filterDateTo }}"
                            class="w-full rounded-md bg-gray-700 px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
                        >
                    </div>

                    <div class="flex items-end gap-2 sm:col-span-4">
                        <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 transition">
                            Filter
                        </button>
                        <a href="{{ path('app_admin_logs') }}" class="px-4 py-2 bg-gray-700 text-gray-300 rounded-md hover:bg-gray-600 transition">
                            Reset
                        </a>
                    </div>
                </form>
            </div>

            <!-- Logs Table -->
            <div class="overflow-hidden rounded-2xl bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 shadow-2xl">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-700/30">
                        <thead class="bg-gray-700/30">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-300 uppercase tracking-wider">Date & Time</th>
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-300 uppercase tracking-wider">User</th>
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-300 uppercase tracking-wider">Role</th>
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-300 uppercase tracking-wider">Action</th>
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-300 uppercase tracking-wider">Target Data</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-700/30 bg-gray-800/30">
                            {% if logs|length == 0 %}
                                <tr>
                                    <td colspan="5" class="px-6 py-12 text-center text-gray-400">
                                        No logs found
                                    </td>
                                </tr>
                            {% else %}
                                {% for log in logs %}
                                    <tr class="hover:bg-gray-700/20 transition">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">
                                            {{ log.dateTime|format_datetime('short', 'short') }}
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">
                                            {{ log.username }}
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                                            <span class="inline-flex items-center gap-1 rounded-lg bg-gradient-to-r from-blue-500/20 to-cyan-500/20 px-3 py-1.5 text-xs font-semibold text-blue-300 ring-1 ring-inset ring-blue-500/30">
                                                {{ log.role|replace({'ROLE_': ''})|replace({', ': ', '}) }}
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                                            {% if log.action == 'CREATE' %}
                                                <span class="inline-flex items-center gap-1 rounded-lg bg-green-500/10 px-3 py-1.5 text-xs font-semibold text-green-400">
                                                    {{ log.action }}
                                                </span>
                                            {% elseif log.action == 'UPDATE' %}
                                                <span class="inline-flex items-center gap-1 rounded-lg bg-blue-500/10 px-3 py-1.5 text-xs font-semibold text-blue-400">
                                                    {{ log.action }}
                                                </span>
                                            {% elseif log.action == 'DELETE' %}
                                                <span class="inline-flex items-center gap-1 rounded-lg bg-red-500/10 px-3 py-1.5 text-xs font-semibold text-red-400">
                                                    {{ log.action }}
                                                </span>
                                            {% elseif log.action in ['LOGIN', 'LOGOUT'] %}
                                                <span class="inline-flex items-center gap-1 rounded-lg bg-purple-500/10 px-3 py-1.5 text-xs font-semibold text-purple-400">
                                                    {{ log.action }}
                                                </span>
                                            {% else %}
                                                <span class="inline-flex items-center gap-1 rounded-lg bg-gray-500/10 px-3 py-1.5 text-xs font-semibold text-gray-400">
                                                    {{ log.action }}
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td class="px-6 py-4 text-sm text-gray-300 max-w-xs truncate" title="{{ log.targetData }}">
                                            {{ log.targetData }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination -->
            {% if totalPages > 1 %}
                <div class="mt-6 flex items-center justify-center gap-2">
                    {% if page > 1 %}
                        <a href="{{ path('app_admin_logs', {page: 1, user: filterUser, action: filterAction, date_from: filterDateFrom, date_to: filterDateTo}) }}" 
                           class="px-3 py-2 rounded-md bg-gray-700 text-gray-300 hover:bg-gray-600">
                            First
                        </a>
                        <a href="{{ path('app_admin_logs', {page: page - 1, user: filterUser, action: filterAction, date_from: filterDateFrom, date_to: filterDateTo}) }}" 
                           class="px-3 py-2 rounded-md bg-gray-700 text-gray-300 hover:bg-gray-600">
                            Previous
                        </a>
                    {% endif %}

                    {% for p in range(1, totalPages) %}
                        {% if p == page %}
                            <span class="px-3 py-2 rounded-md bg-indigo-600 text-white">{{ p }}</span>
                        {% elseif p >= page - 2 and p <= page + 2 %}
                            <a href="{{ path('app_admin_logs', {page: p, user: filterUser, action: filterAction, date_from: filterDateFrom, date_to: filterDateTo}) }}" 
                               class="px-3 py-2 rounded-md bg-gray-700 text-gray-300 hover:bg-gray-600">
                                {{ p }}
                            </a>
                        {% endif %}
                    {% endfor %}

                    {% if page < totalPages %}
                        <a href="{{ path('app_admin_logs', {page: page + 1, user: filterUser, action: filterAction, date_from: filterDateFrom, date_to: filterDateTo}) }}" 
                           class="px-3 py-2 rounded-md bg-gray-700 text-gray-300 hover:bg-gray-600">
                            Next
                        </a>
                        <a href="{{ path('app_admin_logs', {page: totalPages, user: filterUser, action: filterAction, date_from: filterDateFrom, date_to: filterDateTo}) }}" 
                           class="px-3 py-2 rounded-md bg-gray-700 text-gray-300 hover:bg-gray-600">
                            Last
                        </a>
                    {% endif %}
                </div>
            {% endif %}

            <!-- Info -->
            <div class="mt-6 text-sm text-gray-400">
                Showing {{ logs|length }} of {{ total }} logs
            </div>
        </div>
    </main>
</div>
{% endblock %}
