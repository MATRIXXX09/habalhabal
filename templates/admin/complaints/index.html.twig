{% extends 'base.html.twig' %}

{% block title %}Customer Complaints{% endblock %}

{% block body %}
<div class="min-h-full bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900">
    <!-- Admin Sidebar -->
    {{ include('admin/_sidebar.html.twig') }}

    <!-- Main Content -->
    <main class="pl-72">
        <div class="px-8 py-6">
            <!-- Header Section -->
            <div class="list-animate mb-8">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-3xl font-bold text-white mb-2">Customer Complaints</h1>
                        <p class="text-gray-400 flex items-center gap-2">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                            </svg>
                            A list of all customer complaints in the system.
                        </p>
                    </div>
                    <a href="{{ path('app_admin_complaints_new') }}" class="flex items-center gap-2 px-4 py-2 gradient-bg hover:opacity-90 text-white rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Add Complaint
                    </a>
                </div>
                
                <!-- Flash Messages -->
                {% for message in app.flashes('success') %}
                    <div class="alert-animate rounded-xl bg-gradient-to-r from-green-500/10 to-emerald-500/10 p-4 mt-6 border border-green-500/30 shadow-lg">
                        <div class="flex items-center gap-3">
                            <div class="flex-shrink-0">
                                <svg class="h-6 w-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div class="text-sm font-medium text-green-400">{{ message }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <!-- Complaints Table -->
            <div class="list-animate">
                <div class="overflow-hidden rounded-xl bg-gray-800/50 shadow-2xl border border-gray-700/50 backdrop-blur-sm">
                    <div class="overflow-x-auto p-6 text-white">
                        <table id="complaintsTable" class="min-w-full text-white">
                            <thead class="bg-gray-800/80">
                                <tr>
                                    <th scope="col" class="py-4 pl-6 pr-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">
                                        <div class="flex items-center gap-2">
                                            <svg class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                            Customer
                                        </div>
                                    </th>
                                    <th scope="col" class="px-3 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">
                                        <div class="flex items-center gap-2">
                                           <svg class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                                            Message
                                        </div>
                                    </th>
                                    <th scope="col" class="px-3 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">
                                        <div class="flex items-center gap-2">
                                            <svg class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                            Status
                                        </div>
                                    </th>
                                    <th scope="col" class="relative py-4 pl-3 pr-6">
                                        <span class="sr-only">Actions</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-700/30 bg-gray-800/30">
                                {% for complaint in complaints %}
                                <tr class="table-row">
                                    <td class="whitespace-nowrap py-4 pl-6 pr-3 text-sm">
                                        <div class="flex items-center gap-3">
                                            <div class="customer-avatar flex h-10 w-10 items-center justify-center rounded-full text-white font-semibold text-sm shadow-lg">
                                                {{ complaint.customerName|slice(0, 1)|upper }}
                                            </div>
                                            <div>
                                                <div class="font-semibold text-white">{{ complaint.customerName }}</div>
                                                <div class="text-xs text-gray-400">Complaint ID: #{{ complaint.id }}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-3 py-4 text-sm text-gray-300 max-w-sm truncate" title="{{ complaint.message }}">
                                        {{ complaint.message|length > 60 ? complaint.message|slice(0, 60) ~ '...' : complaint.message }}
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm">
                                        {% if complaint.status == 'pending' %}
                                            <span class="badge inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-xs font-semibold bg-gradient-to-r from-yellow-500/20 to-amber-500/20 text-yellow-300 ring-1 ring-inset ring-yellow-400/40">
                                                <span class="status-dot flex h-2 w-2 rounded-full bg-yellow-400"></span>
                                                Pending
                                            </span>
                                        {% else %}
                                            <span class="badge inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-xs font-semibold bg-gradient-to-r from-green-500/20 to-emerald-500/20 text-green-300 ring-1 ring-inset ring-green-400/40">
                                                <span class="status-dot flex h-2 w-2 rounded-full bg-green-400"></span>
                                                Done
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td class="relative whitespace-nowrap py-4 pl-3 pr-6 text-right text-sm">
                                        <div class="flex justify-end gap-2">
                                             <a href="{{ path('app_admin_complaints_edit', {'id': complaint.id}) }}" class="action-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-500/10 text-indigo-400 hover:bg-indigo-500/20 border border-indigo-500/30 transition-all">
                                                 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                                 Edit
                                             </a>
                                            <form method="post" action="{{ path('app_admin_complaints_delete', {'id': complaint.id}) }}" onsubmit="return confirm('Are you sure you want to delete this complaint?');" class="inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ complaint.id) }}">
                                                <button type="submit" class="action-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 border border-red-500/30 transition-all">
                                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="4" class="px-3 py-12 text-center">
                                        <div class="flex flex-col items-center gap-3">
                                            <div class="flex h-16 w-16 items-center justify-center rounded-full bg-gray-700/50">
                                                <svg class="h-8 w-8 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                                            </div>
                                            <div>
                                                <p class="text-sm font-medium text-gray-300">No complaints found</p>
                                                <p class="text-xs text-gray-500 mt-1">When a customer files a complaint, it will appear here.</p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
    // Using a $(document).ready() function to ensure the DOM is fully loaded before initializing DataTable
    $(document).ready(function() {
        // Count only actual data rows, not empty state rows (those with colspan)
        var dataRows = $('#complaintsTable tbody tr').not(':has(td[colspan])').length;
        // Check if DataTable is loaded to prevent errors
        if ($.fn.DataTable && dataRows > 0) {
            $('#complaintsTable').DataTable({
                pageLength: 10,
                order: [[0, 'asc']],
                // Custom language options for a better user experience
                language: {
                    search: "_INPUT_", // Only show the input field
                    searchPlaceholder: "Filter records...",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ complaints",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next &rarr;",
                        previous: "&larr; Previous"
                    },
                    emptyTable: "No complaints found."
                },
                // Custom DOM layout to integrate with Tailwind CSS classes
                dom: '<"top flex items-center  justify-between flex-wrap p-4" <"dataTables_length"l> <"dataTables_filter"f> > rt <"bottom flex items-center justify-between flex-wrap p-4" <"dataTables_info"i> <"dataTables_paginate"p> >'
            });
        } else {
            console.error('DataTables.js not loaded! Please check your script includes.');
        }
    });
</script>
{% endblock %}

