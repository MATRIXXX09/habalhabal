{% extends 'base.html.twig' %}

{% block title %}Add Complaint{% endblock %}

{% block body %}
<div class="min-h-full">
    {{ include('admin/_sidebar.html.twig') }}
    <main class="pl-72">
        <div class="px-8 py-6 max-w-xl mx-auto">
            <h1 class="text-2xl font-semibold text-white mb-6">Add Complaint</h1>
            <form method="post">
                <div class="mb-4">
                    <label class="block text-gray-300 mb-1">Customer Name</label>
                    <input type="text" name="customerName" class="block w-full rounded-md bg-white/5 px-3 py-1.5 text-white" required />
                </div>
                <div class="mb-4">
                    <label class="block text-gray-300 mb-1">Message</label>
                    <textarea name="message" class="block w-full rounded-md bg-white/5 px-3 py-1.5 text-white" required></textarea>
                </div>
                <button type="submit" class="rounded-md bg-indigo-500 px-4 py-2 text-white font-semibold hover:bg-indigo-400">Submit</button>
                <a href="{{ path('app_admin_complaints') }}" class="ml-4 text-gray-400 hover:text-white">Cancel</a>
            </form>
        </div>
    </main>
</div>
{% endblock %}
