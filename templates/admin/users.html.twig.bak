{% extends 'base.html.twig' %}

{% block title %}Admin - Users{% endblock %}

{% block body %}
<div class="min-h-full">
    <!-- Admin Sidebar -->
    <div class="fixed inset-y-0 z-50 flex w-72 flex-col bg-gray-900">
        <div class="flex h-16 shrink-0 items-center px-6">
            <img class="h-8 w-auto" src="{{ asset('images/HABAL.png') }}" alt="Habal-habal">
        </div>
        <nav class="flex flex-1 flex-col px-6 py-4">
            <ul role="list" class="flex flex-1 flex-col gap-y-4">
                <li>
                    <div class="text-xs font-semibold leading-6 text-gray-400">Management</div>
                    <ul role="list" class="-mx-2 mt-2 space-y-1">
                        <li>
                            <a href="{{ path('app_admin_users') }}" class="text-white bg-gray-800 group flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6">
                                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg border border-gray-700 bg-gray-800 text-[0.625rem] font-medium text-white">U</span>
                                <span class="truncate">Users</span>
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('app_admin_shipments') }}" class="text-gray-300 hover:text-white hover:bg-gray-800 group flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6">
                                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg border border-gray-700 bg-gray-800 text-[0.625rem] font-medium text-gray-400 group-hover:text-white">S</span>
                                <span class="truncate">Shipments</span>
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="mt-auto">
                    <a href="{{ path('app_logout') }}" class="text-gray-300 hover:text-white hover:bg-gray-800 group flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6">
                        <svg class="h-6 w-6 shrink-0 text-gray-400 group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
                        </svg>
                        Logout
                    </a>
                </li>
            </ul>
        </nav>
    </div>

    <!-- Main Content -->
    <main class="pl-72">
        <div class="px-8 py-6">
            <div class="sm:flex sm:items-center">
                <div class="sm:flex-auto">
                    <h1 class="text-2xl font-semibold text-white">Users</h1>
                    <p class="mt-2 text-sm text-gray-400">A list of all users in the system.</p>
                </div>
                
                {% for message in app.flashes('success') %}
                    <div class="rounded-md bg-green-500/10 p-4 mt-4 border border-green-500/20">
                        <div class="text-sm text-green-400">{{ message }}</div>
                    </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div class="rounded-md bg-red-500/10 p-4 mt-4 border border-red-500/20">
                        <div class="text-sm text-red-400">{{ message }}</div>
                    </div>
                {% endfor %}

            </div>
            <div class="mt-8 flow-root">
                <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
                    <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
                        <table class="min-w-full divide-y divide-gray-700">
                            <thead>
                                <tr>
                                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-white sm:pl-6">Email</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">Roles</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">Verified</th>
                                    <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                                        <span class="sr-only">Actions</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-800">
                                {% for user in users %}
                                <tr>
                                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-white sm:pl-0">{{ user.email }}</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-300">
                                        {% for role in user.roles %}
                                            <span class="inline-flex items-center rounded-md bg-gray-400/10 px-2 py-1 text-xs font-medium text-gray-400 ring-1 ring-inset ring-gray-400/20">{{ role }}</span>
                                        {% endfor %}
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-300">
                                        {% if user.isVerified %}
                                            <span class="inline-flex items-center rounded-md bg-green-400/10 px-2 py-1 text-xs font-medium text-green-400 ring-1 ring-inset ring-green-400/20">Verified</span>
                                        {% else %}
                                            <span class="inline-flex items-center rounded-md bg-red-400/10 px-2 py-1 text-xs font-medium text-red-400 ring-1 ring-inset ring-red-400/20">Not Verified</span>
                                        {% endif %}
                                    </td>
                                    <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                        <div class="flex justify-end space-x-3">
                                            <a href="{{ path('app_admin_users_edit', {'id': user.id}) }}" class="text-indigo-400 hover:text-indigo-300">Edit</a>
                                            <form method="post" action="{{ path('app_admin_users_delete', {'id': user.id}) }}" onsubmit="return confirm('Are you sure you want to delete this user?');" class="inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                                <button type="submit" class="text-red-400 hover:text-red-300">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}