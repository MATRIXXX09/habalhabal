{% extends 'base.html.twig' %}

{% block title %}Manage Riders{% endblock %}

{% block body %}
<div class="min-h-full bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900">
    <!-- Admin Sidebar -->
    {{ include('admin/_sidebar.html.twig') }}

    <!-- Main Content -->
    <main class="pl-72">
        <div class="px-8 py-6">
            <!-- Header Section -->
            <div class="list-animate mb-8">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-3xl font-bold text-white mb-2">Riders Management</h1>
                        <p class="text-gray-400 flex items-center gap-2">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            Manage all delivery riders, their status, and vehicle information
                        </p>
                    </div>
                    <div class="flex items-center gap-3">
                        <a href="{{ path('app_admin_riders_new') }}" class="flex items-center gap-2 px-4 py-2 gradient-bg hover:opacity-90 text-white rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            Add Rider
                        </a>
                    </div>
                </div>

                <!-- Flash Messages -->
                {% for message in app.flashes('success') %}
                    <div class="alert-animate rounded-xl bg-gradient-to-r from-green-500/10 to-emerald-500/10 p-4 mt-6 border border-green-500/30 shadow-lg">
                        <div class="flex items-center gap-3">
                            <div class="flex-shrink-0">
                                <svg class="h-6 w-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div class="text-sm font-medium text-green-400">{{ message }}</div>
                        </div>
                    </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div class="alert-animate rounded-xl bg-gradient-to-r from-red-500/10 to-pink-500/10 p-4 mt-6 border border-red-500/30 shadow-lg">
                        <div class="flex items-center gap-3">
                            <div class="flex-shrink-0">
                                <svg class="h-6 w-6 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div class="text-sm font-medium text-red-400">{{ message }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <!-- Riders Table -->
            <div class="list-animate">
                <div class="overflow-hidden rounded-xl bg-gray-800/50 shadow-2xl border border-gray-700/50 backdrop-blur-sm">
                    <div class="overflow-x-auto p-6 text-white">
                        <table id="ridersTable" class="min-w-full text-white table-auto-width">
                            <thead class="bg-gray-800/80">
                                <tr>
                                    <th scope="col" class="py-4 pl-6 pr-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">
                                        <div class="flex items-center gap-2">
                                            <svg class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                            </svg>
                                            Rider
                                        </div>
                                    </th>
                                    <th scope="col" class="px-3 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">
                                        <div class="flex items-center gap-2">
                                            <svg class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                            </svg>
                                            Contact
                                        </div>
                                    </th>
                                    <th scope="col" class="px-3 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">
                                        <div class="flex items-center gap-2">
                                            <svg class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                            </svg>
                                            License
                                        </div>
                                    </th>
                                    <th scope="col" class="px-3 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">
                                        <div class="flex items-center gap-2">
                                            <svg class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                            </svg>
                                            Vehicle
                                        </div>
                                    </th>
                                    <th scope="col" class="px-3 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">
                                        <div class="flex items-center gap-2">
                                            <svg class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                            Status
                                        </div>
                                    </th>
                                    <th scope="col" class="relative py-4 pl-3 pr-6">
                                        <span class="sr-only">Actions</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-700/30 bg-gray-800/30">
                                {% for rider in riders %}
                                <tr class="table-row hover:bg-gray-700/20">
                                    <td class="whitespace-nowrap py-4 pl-6 pr-3 text-sm">
                                        <div class="flex items-center gap-3">
                                            <div class="rider-avatar flex h-10 w-10 items-center justify-center rounded-full text-white font-semibold text-sm shadow-lg">
                                                {{ rider.firstName|slice(0, 1)|upper }}{{ rider.lastName|slice(0, 1)|upper }}
                                            </div>
                                            <div>
                                                <div class="font-semibold text-white">{{ rider.firstName }} {{ rider.lastName }}</div>
                                                <div class="text-xs text-gray-400">ID: #{{ rider.id }}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm">
                                        <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-gradient-to-r from-gray-700/50 to-gray-600/50 border border-gray-600/50 inline-flex">
                                            <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                            </svg>
                                            <span class="text-gray-200 font-medium">{{ rider.contactNumber }}</span>
                                        </div>
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm">
                                        <div class="shimmer inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-gradient-to-r from-amber-500/10 to-orange-500/10 border border-amber-500/30">
                                            <svg class="h-4 w-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                            </svg>
                                            <span class="font-mono text-amber-300 font-medium">{{ rider.licenseNumber }}</span>
                                        </div>
                                    </td>
                                    <td class="px-3 py-4 text-sm">
                                        <div class="flex items-start gap-2">
                                            <div class="vehicle-icon flex-shrink-0 mt-0.5">
                                                <svg class="h-5 w-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                                </svg>
                                            </div>
                                            <div>
                                                <div class="text-gray-200 font-medium">{{ rider.vehicleType }}</div>
                                                <div class="mt-1 inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-gray-700/50 border border-gray-600/50">
                                                    <svg class="h-3 w-3 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                                                    </svg>
                                                    <span class="text-xs text-gray-400 font-mono">{{ rider.plateNumber }}</span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm">
                                        <div class="status-dropdown relative inline-block">
                                            <button type="button" class="status-trigger inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-xs font-semibold transition-all cursor-pointer" data-rider-id="{{ rider.id }}" data-current-status="{{ rider.status }}">
                                                {% if rider.status == 'available' %}
                                                    <span class="status-dot flex h-2 w-2 rounded-full bg-green-400 animate-pulse"></span>
                                                    <span class="status-text text-green-300 bg-gradient-to-r from-green-500/20 to-emerald-500/20 ring-1 ring-inset ring-green-400/40 px-2 py-1 rounded">Available</span>
                                                {% elseif rider.status == 'on_delivery' %}
                                                    <span class="status-dot flex h-2 w-2 rounded-full bg-yellow-400 animate-spin" style="animation: spin 3s linear infinite;"></span>
                                                    <span class="status-text text-yellow-300 bg-gradient-to-r from-yellow-500/20 to-amber-500/20 ring-1 ring-inset ring-yellow-400/40 px-2 py-1 rounded">On Delivery</span>
                                                {% elseif rider.status == 'on_leave' %}
                                                    <span class="status-dot flex h-2 w-2 rounded-full bg-blue-400"></span>
                                                    <span class="status-text text-blue-300 bg-gradient-to-r from-blue-500/20 to-cyan-500/20 ring-1 ring-inset ring-blue-400/40 px-2 py-1 rounded">On Leave</span>
                                                {% else %}
                                                    <span class="status-dot flex h-2 w-2 rounded-full bg-gray-400"></span>
                                                    <span class="status-text text-gray-300 bg-gradient-to-r from-gray-500/20 to-slate-500/20 ring-1 ring-inset ring-gray-400/40 px-2 py-1 rounded">Day Off</span>
                                                {% endif %}
                                            </button>
                                            
                                            <!-- Status dropdown menu -->
                                            <div class="status-menu hidden absolute left-0 top-full mt-1 w-48 bg-gray-800 border border-gray-700 rounded-lg shadow-xl z-50 py-1">
                                                <form method="POST" action="{{ path('app_admin_riders_toggle_status', {'id': rider.id}) }}" class="status-option-available">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_status_' ~ rider.id) }}">
                                                    <input type="hidden" name="status" value="available">
                                                    <button type="submit" class="w-full text-left px-4 py-2 text-sm text-green-300 hover:bg-green-500/10 flex items-center gap-2">
                                                        <span class="h-2 w-2 rounded-full bg-green-400"></span>
                                                        Available
                                                    </button>
                                                </form>
                                                <form method="POST" action="{{ path('app_admin_riders_toggle_status', {'id': rider.id}) }}" class="status-option-delivery">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_status_' ~ rider.id) }}">
                                                    <input type="hidden" name="status" value="on_delivery">
                                                    <button type="submit" class="w-full text-left px-4 py-2 text-sm text-yellow-300 hover:bg-yellow-500/10 flex items-center gap-2">
                                                        <span class="h-2 w-2 rounded-full bg-yellow-400 animate-spin" style="animation: spin 3s linear infinite;"></span>
                                                        On Delivery
                                                    </button>
                                                </form>
                                                <form method="POST" action="{{ path('app_admin_riders_toggle_status', {'id': rider.id}) }}" class="status-option-leave">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_status_' ~ rider.id) }}">
                                                    <input type="hidden" name="status" value="on_leave">
                                                    <button type="submit" class="w-full text-left px-4 py-2 text-sm text-blue-300 hover:bg-blue-500/10 flex items-center gap-2">
                                                        <span class="h-2 w-2 rounded-full bg-blue-400"></span>
                                                        On Leave
                                                    </button>
                                                </form>
                                                <form method="POST" action="{{ path('app_admin_riders_toggle_status', {'id': rider.id}) }}" class="status-option-dayoff">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_status_' ~ rider.id) }}">
                                                    <input type="hidden" name="status" value="day_off">
                                                    <button type="submit" class="w-full text-left px-4 py-2 text-sm text-gray-300 hover:bg-gray-700/50 flex items-center gap-2">
                                                        <span class="h-2 w-2 rounded-full bg-gray-400"></span>
                                                        Day Off
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="relative whitespace-nowrap py-4 pl-3 pr-6 text-right text-sm">
                                        <div class="flex justify-end gap-2">
                                            <a href="{{ path('app_admin_riders_edit', {'id': rider.id}) }}" class="action-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-500/10 text-indigo-400 hover:bg-indigo-500/20 border border-indigo-500/30 transition-all">
                                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                </svg>
                                                Edit
                                            </a>
                                            <form method="post" action="{{ path('app_admin_riders_delete', {'id': rider.id}) }}" onsubmit="return confirm('Are you sure you want to delete this rider?');" class="inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rider.id) }}">
                                                <button type="submit" class="action-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 border border-red-500/30 transition-all">
                                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="6" class="px-3 py-12 text-center">
                                        <div class="flex flex-col items-center gap-3">
                                            <div class="flex h-16 w-16 items-center justify-center rounded-full bg-gray-700/50">
                                                <svg class="h-8 w-8 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                </svg>
                                            </div>
                                            <div>
                                                <p class="text-sm font-medium text-gray-300">No riders found</p>
                                                <p class="text-xs text-gray-500 mt-1">Get started by adding a new rider</p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
    // Using a $(document).ready() function to ensure the DOM is fully loaded before initializing DataTable
    $(document).ready(function() {
        // Count only actual data rows, not empty state rows (those with colspan)
        var dataRows = $('#ridersTable tbody tr').not(':has(td[colspan])').length;
        // Check if DataTable is loaded to prevent errors
        if ($.fn.DataTable && dataRows > 0) {
            $('#ridersTable').DataTable({
                pageLength: 10,
                order: [[0, 'asc']],
                // Custom language options for a better user experience
                language: {
                    search: "_INPUT_", // Only show the input field
                    searchPlaceholder: "Filter records...",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ riders",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next &rarr;",
                        previous: "&larr; Previous"
                    },
                    emptyTable: "No riders found."
                },
                // Custom DOM layout to integrate with Tailwind CSS classes
                dom: '<"top flex items-center justify-between flex-wrap p-4" <"dataTables_length"l> <"dataTables_filter"f> > rt <"bottom flex items-center justify-between flex-wrap p-4" <"dataTables_info"i> <"dataTables_paginate"p> >'
            });
        } else {
            console.error('DataTables.js not loaded! Please check your script includes.');
        }

        // Handle status dropdown menu
        document.querySelectorAll('.status-trigger').forEach(trigger => {
            trigger.addEventListener('click', function(e) {
                e.stopPropagation();
                const dropdown = this.closest('.status-dropdown');
                const menu = dropdown.querySelector('.status-menu');
                
                // Close other menus
                document.querySelectorAll('.status-menu.hidden').forEach(m => {
                    if (m !== menu) m.classList.add('hidden');
                });
                
                menu.classList.toggle('hidden');
            });
        });

        // Close dropdown when clicking on status option
        document.querySelectorAll('.status-menu form button').forEach(btn => {
            btn.addEventListener('click', function(e) {
                const form = this.closest('form');
                const dropdown = form.closest('.status-dropdown');
                
                // Show loading state
                const trigger = dropdown.querySelector('.status-trigger');
                trigger.style.opacity = '0.5';
                trigger.style.pointerEvents = 'none';
                
                // Get the new status
                const newStatus = form.querySelector('input[name="status"]').value;
                const statusLabels = {
                    'available': 'Available',
                    'on_delivery': 'On Delivery',
                    'on_leave': 'On Leave',
                    'day_off': 'Day Off'
                };
                
                showNotification(statusLabels[newStatus]);
            });
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.status-dropdown')) {
                document.querySelectorAll('.status-menu').forEach(menu => {
                    menu.classList.add('hidden');
                });
            }
        });

        function showNotification(newStatus) {
            const notification = document.createElement('div');
            notification.className = 'fixed top-4 right-4 p-4 rounded-lg text-white font-medium shadow-lg animate-bounce z-50';
            
            const statusStyles = {
                'Available': 'bg-gradient-to-r from-green-500 to-emerald-500',
                'On Delivery': 'bg-gradient-to-r from-yellow-500 to-amber-500',
                'On Leave': 'bg-gradient-to-r from-blue-500 to-cyan-500',
                'Day Off': 'bg-gradient-to-r from-gray-500 to-slate-500'
            };
            
            const icons = {
                'Available': '✓',
                'On Delivery': '⚙',
                'On Leave': '📋',
                'Day Off': '😴'
            };
            
            notification.classList.add(statusStyles[newStatus] || 'bg-gray-600');
            notification.textContent = icons[newStatus] + ' Status updated to: ' + newStatus;
            
            document.body.appendChild(notification);
            setTimeout(() => {
                notification.style.animation = 'slideOut 0.3s ease-out forwards';
                setTimeout(() => notification.remove(), 300);
            }, 3000);
        }
    });

         // Add CSS animations
         const style = document.createElement('style');
         style.textContent = `
         @keyframes spin {
             from { transform: rotate(0deg); }
             to { transform: rotate(360deg); }
         }
         .animate-pulse {
             animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
         }
         @keyframes pulse {
             0%, 100% { opacity: 1; }
             50% { opacity: .5; }
         }
         @keyframes slideOut {
             to {
                 transform: translateX(400px);
                 opacity: 0;
             }
         }
     `;
     document.head.appendChild(style);
 
     // Listen for DataTable reload event from Socket.IO
     $(document).on('datatable:reload', function() {
         if ($.fn.DataTable) {
             const table = $('#ridersTable').DataTable();
             if (table) {
                 table.ajax.reload();
             }
         }
     });
 