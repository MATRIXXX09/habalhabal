{% extends 'base.html.twig' %}

{% block title %}Edit Rider{% endblock %}

{% block body %}
    <div class="min-h-full">
        <!-- Admin Sidebar -->
        {{ include('admin/_sidebar.html.twig') }}

        <!-- Main Content -->
        <main class="pl-72">
            <div class="px-8 py-6">
                <div class="sm:flex sm:items-center">
                    <div class="sm:flex-auto">
                        <h1 class="text-2xl font-semibold text-white">Edit Rider</h1>
                        <p class="mt-2 text-sm text-gray-300">Update rider information.</p>
                    </div>
                    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
                        <a href="{{ path('app_admin_riders') }}" class="block rounded-md bg-gray-600 px-3 py-2 text-center text-sm font-semibold text-white hover:bg-gray-500">Back to List</a>
                    </div>
                </div>

                <div class="mt-8">
                    {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                        {{ form_errors(form) }}
                        <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
                            <div>
                                {{ form_label(form.firstName, null, {'label_attr': {'class': 'block text-sm font-medium text-white'}}) }}
                                {{ form_widget(form.firstName) }}
                                {{ form_errors(form.firstName) }}
                            </div>

                            <div>
                                {{ form_label(form.lastName, null, {'label_attr': {'class': 'block text-sm font-medium text-white'}}) }}
                                {{ form_widget(form.lastName) }}
                                {{ form_errors(form.lastName) }}
                            </div>

                            <div>
                                {{ form_label(form.contactNumber, null, {'label_attr': {'class': 'block text-sm font-medium text-white'}}) }}
                                {{ form_widget(form.contactNumber) }}
                                {{ form_errors(form.contactNumber) }}
                            </div>

                            <div>
                                {{ form_label(form.licenseNumber, null, {'label_attr': {'class': 'block text-sm font-medium text-white'}}) }}
                                {{ form_widget(form.licenseNumber) }}
                                {{ form_errors(form.licenseNumber) }}
                            </div>

                            <div>
                                {{ form_label(form.vehicleType, null, {'label_attr': {'class': 'block text-sm font-medium text-white'}}) }}
                                {{ form_widget(form.vehicleType, {'attr': {'class': '[&_option]:bg-slate-800 [&_option]:text-white'}}) }}
                                {{ form_errors(form.vehicleType) }}
                            </div>

                            <div>
                                {{ form_label(form.plateNumber, null, {'label_attr': {'class': 'block text-sm font-medium text-white'}}) }}
                                {{ form_widget(form.plateNumber) }}
                                {{ form_errors(form.plateNumber) }}
                            </div>
                        </div>

                        <div class="mt-6 flex items-center justify-end gap-x-6">
                            <button type="submit" class="rounded-md bg-indigo-500 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500">Update Rider</button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </main>
    </div>
{% endblock %}