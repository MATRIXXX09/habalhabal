{% extends 'base.html.twig' %}

{% block title %}Bookings - Admin Panel{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-gray-950 via-gray-900 to-gray-950">
    {{ include('admin/_sidebar.html.twig') }}

    <main class="pl-72">
        <div class="px-8 py-6">
            <div class="mb-12">
                <div class="flex justify-between items-start">
                    <div>
                        <h1 class="text-5xl font-bold text-white">Bookings</h1>
                        <p class="text-gray-400 mt-2 text-lg">All bookings stored in the database</p>
                    </div>
                </div>
            </div>

            <div class="bg-white/10 backdrop-blur-md rounded-lg border border-white/20 p-4 mb-8">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <input type="text" placeholder="Search by customer name..." id="searchInput" class="px-4 py-2 rounded-lg bg-white/20 border border-white/30 text-white placeholder-gray-300 focus:outline-none focus:border-green-400">
                    <select id="statusFilter" class="px-4 py-2 rounded-lg bg-white/20 border border-white/30 text-white focus:outline-none focus:border-green-400 [&_option]:bg-slate-800 [&_option]:text-white">
                        <option value="">All Statuses</option>
                        <option value="pending">Pending</option>
                        <option value="confirmed">Confirmed</option>
                        <option value="assigned">Assigned</option>
                        <option value="in_transit">In Transit</option>
                        <option value="completed">Completed</option>
                        <option value="cancelled">Cancelled</option>
                    </select>
                    <select id="typeFilter" class="px-4 py-2 rounded-lg bg-white/20 border border-white/30 text-white focus:outline-none focus:border-green-400 [&_option]:bg-slate-800 [&_option]:text-white">
                        <option value="">All Types</option>
                        <option value="delivery">Delivery</option>
                        <option value="pickup">Pickup</option>
                    </select>
                </div>
            </div>

            {% if bookings %}
                <div class="bg-white/10 backdrop-blur-md rounded-lg border border-white/20 overflow-hidden shadow-xl">
                    <table class="w-full">
                        <thead class="bg-white/5 border-b border-white/20">
                            <tr>
                                <th class="px-6 py-4 text-left text-gray-200 font-semibold">ID</th>
                                <th class="px-6 py-4 text-left text-gray-200 font-semibold">Customer</th>
                                <th class="px-6 py-4 text-left text-gray-200 font-semibold">Type</th>
                                <th class="px-6 py-4 text-left text-gray-200 font-semibold">Pickup</th>
                                <th class="px-6 py-4 text-left text-gray-200 font-semibold">Delivery</th>
                                <th class="px-6 py-4 text-left text-gray-200 font-semibold">Status</th>
                                <th class="px-6 py-4 text-left text-gray-200 font-semibold">Driver</th>
                                <th class="px-6 py-4 text-left text-gray-200 font-semibold">Created By</th>
                                <th class="px-6 py-4 text-left text-gray-200 font-semibold">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for booking in bookings %}
                                <tr class="border-b border-white/10 hover:bg-white/5 transition" data-type="{{ booking.bookingType }}" data-status="{{ booking.status }}">
                                    <td class="px-6 py-4 text-white font-mono text-sm">#{{ booking.id }}</td>
                                    <td class="px-6 py-4">
                                        <div class="text-white font-medium">{{ booking.customerName }}</div>
                                        <div class="text-gray-300 text-sm">{{ booking.customerPhone }}</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-3 py-1 rounded-full text-xs font-semibold {% if booking.bookingType == 'delivery' %}bg-blue-500/20 text-blue-200{% else %}bg-purple-500/20 text-purple-200{% endif %}">
                                            {{ booking.bookingType|capitalize }}
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-gray-200 text-sm">
                                        <div>{{ booking.pickupAddress|slice(0, 30) }}{% if booking.pickupAddress|length > 30 %}...{% endif %}</div>
                                        <div class="text-xs text-gray-400">{{ booking.requestedPickupTime|date('M d, H:i') }}</div>
                                    </td>
                                    <td class="px-6 py-4 text-gray-200 text-sm">
                                        <div>{{ booking.deliveryAddress|slice(0, 30) }}{% if booking.deliveryAddress|length > 30 %}...{% endif %}</div>
                                        {% if booking.requestedDeliveryTime %}
                                            <div class="text-xs text-gray-400">{{ booking.requestedDeliveryTime|date('M d, H:i') }}</div>
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-3 py-1 rounded-full text-xs font-semibold 
                                            {% if booking.status == 'pending' %}bg-yellow-500/20 text-yellow-200
                                            {% elseif booking.status == 'confirmed' %}bg-blue-500/20 text-blue-200
                                            {% elseif booking.status == 'assigned' %}bg-cyan-500/20 text-cyan-200
                                            {% elseif booking.status == 'in_transit' %}bg-orange-500/20 text-orange-200
                                            {% elseif booking.status == 'completed' %}bg-green-500/20 text-green-200
                                            {% elseif booking.status == 'cancelled' %}bg-red-500/20 text-red-200
                                            {% endif %}">
                                            {{ booking.status|replace({'_': ' '})|capitalize }}
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-gray-200 text-sm">
                                        {% if booking.assignedDriver %}
                                            <div class="font-medium">{{ booking.assignedDriver.firstName }} {{ booking.assignedDriver.lastName }}</div>
                                            <div class="text-xs text-gray-400">{{ booking.assignedDriver.plateNumber }}</div>
                                        {% else %}
                                            <span class="text-gray-400 italic">Unassigned</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 text-gray-200 text-sm">
                                        {% if booking.createdBy %}
                                            <div class="font-medium">{{ booking.createdBy.email }}</div>
                                            <div class="text-xs text-gray-400">{{ booking.createdAt|date('M d, H:i') }}</div>
                                        {% else %}
                                            <span class="text-gray-400 italic">Unknown</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex flex-wrap gap-2">
                                            <a href="{{ path('staff_booking_show', {id: booking.id}) }}" class="px-3 py-1 bg-indigo-600/20 text-indigo-200 rounded hover:bg-indigo-600/40 transition text-xs font-semibold">
                                                View
                                            </a>
                                            <a href="{{ path('staff_booking_edit', {id: booking.id}) }}" class="px-3 py-1 bg-blue-600/20 text-blue-200 rounded hover:bg-blue-600/40 transition text-xs font-semibold">
                                                Edit
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="bg-white/10 backdrop-blur-md rounded-lg border border-white/20 p-12 text-center">
                    <h3 class="text-2xl font-bold text-white mb-2">No Bookings Yet</h3>
                    <p class="text-gray-300">Bookings will appear here once they are created.</p>
                </div>
            {% endif %}
        </div>
    </main>
</div>

<script>
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');
    const typeFilter = document.getElementById('typeFilter');
    const rows = document.querySelectorAll('tbody tr');

    function filterTable() {
        const searchTerm = searchInput.value.toLowerCase();
        const selectedStatus = statusFilter.value;
        const selectedType = typeFilter.value;

        rows.forEach(row => {
            let show = true;

            if (searchTerm) {
                show = row.textContent.toLowerCase().includes(searchTerm);
            }

            if (show && selectedStatus) {
                show = row.dataset.status === selectedStatus;
            }

            if (show && selectedType) {
                show = row.dataset.type === selectedType;
            }

            row.style.display = show ? '' : 'none';
        });
    }

    searchInput.addEventListener('input', filterTable);
    statusFilter.addEventListener('change', filterTable);
    typeFilter.addEventListener('change', filterTable);
</script>
{% endblock %}