{% extends 'base.html.twig' %}

{% block title %}Edit Vehicle{% endblock %}

{% block body %}
<div class="min-h-full bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900">
    {{ include('admin/_sidebar.html.twig') }}

    <main class="pl-72">
        <div class="px-8 py-6">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h1 class="text-3xl font-bold text-white mb-2">Edit Vehicle</h1>
                    <p class="text-gray-400">Update vehicle information - {{ vehicle.plateNumber }}</p>
                </div>
                <a href="{{ path('app_admin_vehicles') }}" class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-gray-600 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500">
                    <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                    </svg>
                    Back to List
                </a>
            </div>

            <div class="bg-gray-800/50 shadow-xl rounded-lg overflow-hidden border border-gray-700">
                {{ form_start(form, {'attr': {'class': 'space-y-6 p-6', 'id': 'vehicle-form'}}) }}
                
                <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-2">
                    <div>
                        {{ form_row(form.type, {'attr': {'class': '[&_option]:bg-slate-800 [&_option]:text-white'}}) }}
                    </div>

                    <div>
                        {{ form_row(form.model, {'attr': {'class': '[&_option]:bg-slate-800 [&_option]:text-white'}}) }}
                    </div>

                    <div>
                        {{ form_row(form.plateNumber) }}
                    </div>

                    <div>
                        {{ form_row(form.capacity) }}
                    </div>

                    <div class="sm:col-span-2">
                        {{ form_row(form.currentLocation) }}
                    </div>
                    
                    <div class="sm:col-span-2 flex items-center">
                        {{ form_widget(form.isAvailable) }}
                        {{ form_label(form.isAvailable, 'Is Available?', {'label_attr': {'class': 'ml-2 text-sm font-medium text-gray-300'}}) }}
                    </div>
                </div>

                <div class="flex justify-end gap-3">
                    <a href="{{ path('app_admin_vehicles') }}" class="inline-flex justify-center py-2 px-4 border border-gray-600 shadow-sm text-sm font-medium rounded-md text-gray-300 bg-gray-700 hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500">
                        Cancel
                    </a>
                    <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Update Vehicle
                    </button>
                </div>
                {{ form_end(form) }}
            </div>

            <div class="mt-6 bg-gray-800/30 rounded-lg p-4 border border-gray-700/50">
                <div class="flex items-center gap-2 text-sm text-gray-400">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span><strong>Last Updated:</strong> {{ vehicle.createdAt|date('F d, Y - h:i A') }}</span>
                </div>
            </div>
        </div>
    </main>
</div>

{% endblock %}

