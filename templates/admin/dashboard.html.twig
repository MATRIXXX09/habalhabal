{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block body %}
<div class="min-h-full bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900">
    <!-- Admin Sidebar -->
    {{ include('admin/_sidebar.html.twig') }}

    <!-- Main Content -->
    <main class="pl-72">
        <div class="px-8 py-6">
            <!-- Header -->
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h1 class="text-3xl font-bold text-white mb-2">Admin Dashboard</h1>
                    <p class="text-gray-400">Overview of your platform statistics</p>
                </div>
                <div class="flex items-center gap-x-4 bg-gray-800/50 rounded-lg px-4 py-3 border border-gray-700">
                    <!-- Messages Notification -->
                    <a href="{{ path('app_admin_messages') }}" class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-gray-700/50 transition-colors relative group">
                        <div class="relative">
                            <svg class="h-5 w-5 text-gray-400 group-hover:text-blue-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                            {% if unreadMessageCount > 0 %}
                                <span class="absolute top-0 right-0 inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-white transform translate-x-1 -translate-y-1 bg-red-600 rounded-full">{{ unreadMessageCount }}</span>
                            {% endif %}
                        </div>
                        <span class="text-sm text-gray-400 group-hover:text-blue-400 transition-colors">
                            {% if unreadMessageCount > 0 %}
                                {{ unreadMessageCount }} {{ unreadMessageCount == 1 ? 'message' : 'messages' }}
                            {% else %}
                                Messages
                            {% endif %}
                        </span>
                    </a>
                    <div class="h-6 w-px bg-gray-700"></div>
                    <div class="flex items-center gap-2">
                        <div class="h-2 w-2 rounded-full bg-green-500 animate-pulse"></div>
                        <span class="text-sm text-gray-300">Online</span>
                    </div>
                    <div class="h-6 w-px bg-gray-700"></div>
                    <span class="text-sm text-gray-300">{{ app.user.email }}</span>
                </div>
            </div>

            <!-- Primary Statistics Cards - Row 1 -->
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 mb-8">
                <!-- Users Card -->
                <div class="card-animate card-hover overflow-hidden rounded-xl bg-white shadow-lg">
                    <div class="p-6">
                        <div class="flex items-center justify-between">
                            <div class="flex-1">
                                <p class="text-sm font-medium text-gray-500 mb-2">Total Users</p>
                                <p class="text-4xl font-bold text-indigo-600">{{ users }}</p>
                            </div>
                            <div class="flex-shrink-0">
                                <div class="h-14 w-14 rounded-lg bg-indigo-100 flex items-center justify-center">
                                    <svg class="h-7 w-7 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                        <div class="mt-6">
                            <a href="{{ path('app_admin_users') }}" class="text-sm font-medium text-indigo-600 hover:text-indigo-800 flex items-center gap-2">
                                View all users
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Shipments Card -->
                <div class="card-animate card-hover overflow-hidden rounded-xl bg-white shadow-lg">
                    <div class="p-6">
                        <div class="flex items-center justify-between">
                            <div class="flex-1">
                                <p class="text-sm font-medium text-gray-500 mb-2">Total Shipments</p>
                                <p class="text-4xl font-bold text-pink-600">{{ shipments }}</p>
                            </div>
                            <div class="flex-shrink-0">
                                <div class="h-14 w-14 rounded-lg bg-pink-100 flex items-center justify-center">
                                    <svg class="h-7 w-7 text-pink-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                        <div class="mt-6">
                            <a href="{{ path('app_admin_shipments') }}" class="text-sm font-medium text-pink-600 hover:text-pink-800 flex items-center gap-2">
                                View all shipments
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Complaints Card -->
                <div class="card-animate card-hover overflow-hidden rounded-xl bg-white shadow-lg">
                    <div class="p-6">
                        <div class="flex items-center justify-between">
                            <div class="flex-1">
                                <p class="text-sm font-medium text-gray-500 mb-2">Total Complaints</p>
                                <p class="text-4xl font-bold text-cyan-600">{{ complaints_total }}</p>
                                <div class="flex gap-4 mt-3">
                                    <div class="flex items-center gap-1">
                                        <div class="h-2 w-2 rounded-full bg-yellow-500"></div>
                                        <span class="text-xs text-gray-600">Pending: <strong>{{ complaints_pending }}</strong></span>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <div class="h-2 w-2 rounded-full bg-green-500"></div>
                                        <span class="text-xs text-gray-600">Done: <strong>{{ complaints_done }}</strong></span>
                                    </div>
                                </div>
                            </div>
                            <div class="flex-shrink-0">
                                <div class="h-14 w-14 rounded-lg bg-cyan-100 flex items-center justify-center">
                                    <svg class="h-7 w-7 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                        <div class="mt-6">
                            <a href="{{ path('app_admin_complaints') }}" class="text-sm font-medium text-cyan-600 hover:text-cyan-800 flex items-center gap-2">
                                View all complaints
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Vehicles Card -->
                <div class="card-animate card-hover overflow-hidden rounded-xl bg-white shadow-lg">
                    <div class="p-6">
                        <div class="flex items-center justify-between">
                            <div class="flex-1">
                                <p class="text-sm font-medium text-gray-500 mb-2">Total Vehicles</p>
                                <p class="text-4xl font-bold text-purple-600">{{ vehicles }}</p>
                                <div class="flex gap-4 mt-3">
                                    <div class="flex items-center gap-1">
                                        <div class="h-2 w-2 rounded-full bg-green-500"></div>
                                        <span class="text-xs text-gray-600">Available: <strong>{{ vehicles_available }}</strong></span>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <div class="h-2 w-2 rounded-full bg-red-500"></div>
                                        <span class="text-xs text-gray-600">Assigned: <strong>{{ vehicles_in_use }}</strong></span>
                                    </div>
                                </div>
                            </div>
                            <div class="flex-shrink-0">
                                <div class="h-14 w-14 rounded-lg bg-purple-100 flex items-center justify-center">
                                    <svg class="h-7 w-7 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                        <div class="mt-6">
                            <a href="{{ path('app_admin_vehicles') }}" class="text-sm font-medium text-purple-600 hover:text-purple-800 flex items-center gap-2">
                                View all vehicles
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Secondary Statistics Cards - Row 2 -->
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 mb-8">
                <!-- Active Users Card -->
                <div class="card-animate card-hover overflow-hidden rounded-xl bg-white shadow-lg">
                    <div class="p-6">
                        <div class="flex items-center justify-between">
                            <div class="flex-1">
                                <p class="text-sm font-medium text-gray-500 mb-2">Active Users</p>
                                <p class="text-4xl font-bold text-green-600">{{ active_users }}</p>
                                <p class="text-xs text-gray-500 mt-2">{{ ((active_users / users * 100) | round(1)) }}% of total</p>
                            </div>
                            <div class="flex-shrink-0">
                                <div class="h-14 w-14 rounded-lg bg-green-100 flex items-center justify-center">
                                    <svg class="h-7 w-7 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Staff Card -->
                <div class="card-animate card-hover overflow-hidden rounded-xl bg-white shadow-lg">
                    <div class="p-6">
                        <div class="flex items-center justify-between">
                            <div class="flex-1">
                                <p class="text-sm font-medium text-gray-500 mb-2">Staff Members</p>
                                <p class="text-4xl font-bold text-blue-600">{{ staff_count }}</p>
                                <div class="flex gap-4 mt-3">
                                    <div class="flex items-center gap-1">
                                        <div class="h-2 w-2 rounded-full bg-blue-500"></div>
                                        <span class="text-xs text-gray-600">Riders: <strong>{{ riders_count }}</strong></span>
                                    </div>
                                </div>
                            </div>
                            <div class="flex-shrink-0">
                                <div class="h-14 w-14 rounded-lg bg-blue-100 flex items-center justify-center">
                                    <svg class="h-7 w-7 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delivered Shipments Card -->
                <div class="card-animate card-hover overflow-hidden rounded-xl bg-white shadow-lg">
                    <div class="p-6">
                        <div class="flex items-center justify-between">
                            <div class="flex-1">
                                <p class="text-sm font-medium text-gray-500 mb-2">Delivered</p>
                                <p class="text-4xl font-bold text-emerald-600">{{ shipments_delivered }}</p>
                                <div class="flex gap-2 mt-3">
                                    <span class="text-xs text-gray-600">Pending: <strong>{{ shipments_pending }}</strong></span>
                                    <span class="text-xs text-gray-600">Transit: <strong>{{ shipments_in_transit }}</strong></span>
                                </div>
                            </div>
                            <div class="flex-shrink-0">
                                <div class="h-14 w-14 rounded-lg bg-emerald-100 flex items-center justify-center">
                                    <svg class="h-7 w-7 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Disabled Users Card -->
                <div class="card-animate card-hover overflow-hidden rounded-xl bg-white shadow-lg">
                    <div class="p-6">
                        <div class="flex items-center justify-between">
                            <div class="flex-1">
                                <p class="text-sm font-medium text-gray-500 mb-2">Disabled Users</p>
                                <p class="text-4xl font-bold text-red-600">{{ disabled_users }}</p>
                                <p class="text-xs text-gray-500 mt-2">{{ ((disabled_users / users * 100) | round(1)) }}% of total</p>
                            </div>
                            <div class="flex-shrink-0">
                                <div class="h-14 w-14 rounded-lg bg-red-100 flex items-center justify-center">
                                    <svg class="h-7 w-7 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4v2m0 5v1m0-1a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Activity Section -->
            {% if recent_activities %}
            <div class="bg-white rounded-xl shadow-lg overflow-hidden mb-8">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-800">Recent Activities</h2>
                </div>
                <div class="divide-y divide-gray-200">
                    {% for activity in recent_activities %}
                    <div class="px-6 py-4 hover:bg-gray-50 transition">
                        <div class="flex items-center justify-between">
                            <div class="flex-1">
                                <p class="text-sm font-medium text-gray-900">{{ activity.action }}</p>
                                <p class="text-xs text-gray-500 mt-1">
                                    User: <span class="font-semibold">{{ activity.username }}</span> | Role: <span class="font-semibold">{{ activity.role }}</span>
                                </p>
                            </div>
                            <div class="text-right">
                                <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 mb-2">
                                    {{ activity.action }}
                                </span>
                                <p class="text-xs text-gray-500">
                                    {{ activity.dateTime|date('M d, Y H:i') }}
                                </p>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
            {% endblock %}
