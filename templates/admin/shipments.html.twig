{% extends 'base.html.twig' %}

{% block title %}Admin - Shipments{% endblock %}

{% block body %}
<div class="min-h-full bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900">
    <!-- Admin Sidebar -->
    {{ include('admin/_sidebar.html.twig') }}

    <!-- Main Content -->
    <main class="pl-72">
        <div class="px-8 py-6">
            <!-- Header Section -->
            <div class="list-animate mb-8">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-3xl font-bold text-white mb-2">Shipments Management</h1>
                        <p class="text-gray-400 flex items-center gap-2">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                            </svg>
                            Track and manage all shipments across the system
                        </p>
                    </div>
                    <div class="flex items-center gap-3">
                        <button class="flex items-center gap-2 px-4 py-2 bg-gray-700/50 hover:bg-gray-700 text-gray-300 rounded-lg transition-all duration-200 border border-gray-600">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                            </svg>
                            Filter
                        </button>
                        <a href="{{ path('app_shipment_new') }}" class="flex items-center gap-2 px-4 py-2 gradient-bg hover:opacity-90 text-white rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            Add Shipment
                        </a>
                    </div>
                </div>
                
                <!-- Flash Messages -->
                {% for message in app.flashes('success') %}
                    <div class="alert-animate rounded-xl bg-gradient-to-r from-green-500/10 to-emerald-500/10 p-4 mt-6 border border-green-500/30 shadow-lg">
                        <div class="flex items-center gap-3">
                            <div class="flex-shrink-0">
                                <svg class="h-6 w-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div class="text-sm font-medium text-green-400">{{ message }}</div>
                        </div>
                    </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div class="alert-animate rounded-xl bg-gradient-to-r from-red-500/10 to-pink-500/10 p-4 mt-6 border border-red-500/30 shadow-lg">
                        <div class="flex items-center gap-3">
                            <div class="flex-shrink-0">
                                <svg class="h-6 w-6 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div class="text-sm font-medium text-red-400">{{ message }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <!-- Shipments Table -->
            <div class="list-animate">
                <div class="overflow-hidden rounded-xl bg-gray-800/50 shadow-2xl border border-gray-700/50 backdrop-blur-sm">
                    <div class="overflow-x-auto p-6 text-white">
                        <table id="usersTable" class="min-w-full text-white table-full-width">
                            <thead class="bg-gray-800/80">
                                <tr>
                                    <th scope="col" class="py-4 pl-6 pr-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">
                                        <div class="flex items-center gap-2">
                                            <svg class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
                                            </svg>
                                            ID
                                        </div>
                                    </th>
                                    <th scope="col" class="px-3 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">
                                        <div class="flex items-center gap-2">
                                            <svg class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
                                            </svg>
                                            Tracking Number
                                        </div>
                                    </th>
                                    <th scope="col" class="px-3 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">
                                        <div class="flex items-center gap-2">
                                            <svg class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                            Status
                                        </div>
                                    </th>
                                    <th scope="col" class="px-3 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">
                                        <div class="flex items-center gap-2">
                                            <svg class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                            </svg>
                                            Origin
                                        </div>
                                    </th>
                                    <th scope="col" class="px-3 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">
                                        <div class="flex items-center gap-2">
                                            <svg class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                            </svg>
                                            Destination
                                        </div>
                                    </th>
                                    <th scope="col" class="px-3 py-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-300">
                                        <div class="flex items-center gap-2">
                                            <svg class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                            </svg>
                                            Created At
                                        </div>
                                    </th>
                                    <th scope="col" class="relative py-4 pl-3 pr-6">
                                        <span class="sr-only">Actions</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-700/30 bg-gray-800/30">
                                {% for shipment in shipments %}
                                <tr class="table-row hover:bg-gray-700/20">
                                    <td class="whitespace-nowrap py-4 pl-6 pr-3 text-sm">
                                        <div class="flex items-center">
                                            <span class="inline-flex items-center justify-center h-8 w-8 rounded-lg bg-gradient-to-br from-indigo-500/20 to-purple-500/20 border border-indigo-500/30">
                                                <span class="text-xs font-bold text-indigo-400">{{ shipment.id }}</span>
                                            </span>
                                        </div>
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm">
                                        <div class="tracking-badge inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-gradient-to-r from-gray-700/50 to-gray-600/50 border border-gray-600/50">
                                            <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
                                            </svg>
                                            <span class="font-mono text-gray-200 font-medium">{{ shipment.trackingNumber }}</span>
                                        </div>
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm">
                                        <span class="badge inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-semibold
                                            {% if shipment.status == 'pending' %}
                                                bg-gradient-to-r from-yellow-500/20 to-amber-500/20 text-yellow-300 ring-1 ring-inset ring-yellow-400/40
                                            {% elseif shipment.status == 'in_transit' %}
                                                bg-gradient-to-r from-blue-500/20 to-cyan-500/20 text-blue-300 ring-1 ring-inset ring-blue-400/40
                                            {% elseif shipment.status == 'delivered' %}
                                                bg-gradient-to-r from-green-500/20 to-emerald-500/20 text-green-300 ring-1 ring-inset ring-green-400/40
                                            {% else %}
                                                bg-gradient-to-r from-gray-500/20 to-slate-500/20 text-gray-300 ring-1 ring-inset ring-gray-400/40
                                            {% endif %}
                                        ">
                                            {% if shipment.status == 'pending' %}
                                                <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                                                </svg>
                                            {% elseif shipment.status == 'in_transit' %}
                                                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                                                </svg>
                                            {% elseif shipment.status == 'delivered' %}
                                                <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                                </svg>
                                            {% endif %}
                                            {{ shipment.status|title|replace({'_': ' '}) }}
                                        </span>
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm">
                                        <div class="flex items-center gap-2">
                                            <span class="text-gray-300 font-medium">{{ shipment.origin }}</span>
                                        </div>
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm">
                                        <div class="flex items-center gap-2">
                                            <span class="text-gray-300 font-medium">{{ shipment.destination }}</span>
                                        </div>
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-400">
                                        <div class="flex items-center gap-2">
                                            <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                            {{ shipment.createdAt ? shipment.createdAt|date('M d, Y H:i') : 'N/A' }}
                                        </div>
                                    </td>
                                    <td class="relative whitespace-nowrap py-4 pl-3 pr-6 text-right text-sm">
                                        <div class="flex justify-end gap-2">
                                            <a href="{{ path('app_shipment_edit', {'id': shipment.id}) }}" class="action-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-500/10 text-indigo-400 hover:bg-indigo-500/20 border border-indigo-500/30 transition-all">
                                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                </svg>
                                                Edit
                                            </a>
                                            <form method="post" action="{{ path('app_shipment_delete', {'id': shipment.id}) }}" onsubmit="return confirm('Are you sure you want to delete this shipment?');" class="inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ shipment.id) }}">
                                                <button class="action-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 border border-red-500/30 transition-all">
                                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="7" class="px-3 py-12 text-center">
                                        <div class="flex flex-col items-center gap-3">
                                            <div class="flex h-16 w-16 items-center justify-center rounded-full bg-gray-700/50">
                                                <svg class="h-8 w-8 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                                                </svg>
                                            </div>
                                            <div>
                                                <p class="text-sm font-medium text-gray-300">No shipments found</p>
                                                <p class="text-xs text-gray-500 mt-1">Get started by creating a new shipment</p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
    // Using a $(document).ready() function to ensure the DOM is fully loaded before initializing DataTable
    $(document).ready(function() {
        // Count only actual data rows, not empty state rows (those with colspan)
        var dataRows = $('#usersTable tbody tr').not(':has(td[colspan])').length;
        // Check if DataTable is loaded to prevent errors
        if ($.fn.DataTable && dataRows > 0) {
            $('#usersTable').DataTable({
                pageLength: 10,
                order: [[0, 'asc']],
                // Custom language options for a better user experience
                language: {
                    search: "_INPUT_", // Only show the input field
                    searchPlaceholder: "Filter records...",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ shipments",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next &rarr;",
                        previous: "&larr; Previous"
                    },
                    emptyTable: "No shipments found."
                },
                // Custom DOM layout to integrate with Tailwind CSS classes
                dom: '<"top flex items-center justify-between flex-wrap p-4" <"dataTables_length"l> <"dataTables_filter"f> > rt <"bottom flex items-center justify-between flex-wrap p-4" <"dataTables_info"i> <"dataTables_paginate"p> >'
            });
        } else {
            console.error('DataTables.js not loaded! Please check your script includes.');
        }

        // Listen for DataTable reload event from Socket.IO
        $(document).on('datatable:reload', function() {
            if ($.fn.DataTable) {
                const table = $('#usersTable').DataTable();
                if (table) {
                    table.ajax.reload();
                }
            }
        });
    });
</script>
{% endblock %}

