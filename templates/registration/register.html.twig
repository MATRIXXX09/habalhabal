{% extends "base.html.twig" %}

{% block title %}Register - Habal Habal Management System{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-900 py-12 px-4 sm:px-6 lg:px-8 flex items-center justify-center">
    <div class="w-full max-w-md space-y-8">
        <!-- Header -->
        <div class="flex justify-center">
            <img class="h-12 w-auto" src="{{ asset('images/HABAL.png') }}" alt="Habal-habal">
        </div>

        <div>
            <h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-white">
                Create an account
            </h2>
            <p class="mt-2 text-center text-sm text-gray-400">
                Register a new account to access the system
            </p>
        </div>

        <!-- Register Form -->
        {{ form_start(registrationForm, {'attr': {'class': 'mt-8 space-y-6'}}) }}
            <div class="rounded-lg bg-gray-800 p-6 space-y-4">
                <!-- Email Field -->
                <div>
                    <label for="{{ registrationForm.email.vars.id }}" class="block text-sm font-medium text-gray-300 mb-2">
                        Email address
                    </label>
                    {{ form_widget(registrationForm.email, {
                        'attr': {
                            'class': 'block w-full rounded-md bg-gray-700 px-3 py-2 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-gray-800',
                            'placeholder': 'user@example.com'
                        }
                    }) }}
                    {% if registrationForm.email.vars.errors %}
                        <div class="mt-2 text-sm text-red-400">
                            {{ form_errors(registrationForm.email) }}
                        </div>
                    {% endif %}
                </div>

                <!-- Password Field -->
                <div>
                    <label for="{{ registrationForm.plainPassword.vars.id }}" class="block text-sm font-medium text-gray-300 mb-2">
                        Password
                    </label>
                    {{ form_widget(registrationForm.plainPassword, {
                        'attr': {
                            'class': 'block w-full rounded-md bg-gray-700 px-3 py-2 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-gray-800',
                            'placeholder': '••••••••'
                        }
                    }) }}
                    {% if registrationForm.plainPassword.vars.errors %}
                        <div class="mt-2 text-sm text-red-400">
                            {{ form_errors(registrationForm.plainPassword) }}
                        </div>
                    {% endif %}
                </div>

                <!-- Terms and Conditions -->
                <div class="flex items-center">
                    {{ form_widget(registrationForm.agreeTerms, {
                        'attr': {
                            'class': 'h-4 w-4 rounded border-gray-600 bg-gray-700 text-indigo-500 focus:ring-indigo-500'
                        }
                    }) }}
                    <label for="{{ registrationForm.agreeTerms.vars.id }}" class="ml-2 block text-sm text-gray-400">
                        {{ registrationForm.agreeTerms.vars.label }}
                    </label>
                    {% if registrationForm.agreeTerms.vars.errors %}
                        <div class="ml-2 text-sm text-red-400">
                            {{ form_errors(registrationForm.agreeTerms) }}
                        </div>
                    {% endif %}
                </div>

                <!-- CSRF Token (already included in form_end) -->

                <!-- Submit Button -->
                <button 
                    type="submit" 
                    class="w-full rounded-md bg-indigo-500 py-2 px-4 text-sm font-semibold text-white hover:bg-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-gray-800 transition-colors"
                >
                    Register
                </button>
            </div>
        {{ form_end(registrationForm) }}

        <!-- Google Sign Up -->
        <div class="rounded-lg bg-gray-800 p-4 border border-gray-700">
            <a href="{{ path('connect_google') }}" class="w-full flex items-center justify-center gap-2 bg-white text-gray-900 hover:bg-gray-100 font-semibold py-2 px-4 rounded-md transition-colors">
                <svg class="w-5 h-5" viewBox="0 0 24 24">
                    <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                Sign up with Google
            </a>
        </div>

        <!-- Sign In Link -->
        <div class="rounded-lg bg-gray-800 p-4 border border-gray-700 text-center text-sm text-gray-400">
            <p>Already have an account? <a href="{{ path('app_login') }}" class="text-indigo-400 hover:underline">Sign in</a></p>
        </div>
    </div>
</div>
{% endblock %}
